# 企业现场已部署的 worker runtime / toolbox 组件基线（构建机侧抄录，用于代码变更包）。
#
# 来源：2026-09-14 由现场 `.4/.114` 的 `/data/testagent/config/release-component-state.env`
# 提供 `TEST_AGENT_RELEASE_WORKER_RUNTIME_FINGERPRINT` 与 `TEST_AGENT_RELEASE_TOOLBOX_FINGERPRINT`
# 两个 key 的原值；不是本机 `dist/.release-component-state.env` 的值。
#
# 用途：以 `--component-state-file` 传入。打包脚本会把工作树里算出的指纹与本文件比对：
#   相等 -> 该组件声明 reuse（小包、现场不重启）；不等 -> 该组件声明 included（大包、需 docker load）。
# 因此本文件同时是“现场基线”和“漂移告警线”：一旦有人改动了 worker/toolbox 指纹输入，
# `--component-plan-only` 会立刻显示 included，而不是等到企业部署时才被现场门禁拦下。
#
# 现场这两个值对应 2026-09-07 全量包（源码 commit 5843fb7f72925f3193f3fcd72b68e592dc76baf7）。
# 校验方法见 `.agents/skills/enterprise-offline-deploy/references/release-rebuild-signing-pitfalls.md`
# 第 6.1 节（worker 指纹只跟源码提交走，可用它反查现场版本）。
TEST_AGENT_RELEASE_COMPONENT_STATE_VERSION=1
TEST_AGENT_RELEASE_WORKER_RUNTIME_FINGERPRINT=aba0bb06f75eb56f694f5e630d00ab4787062f7cc549dda2b5c018182127687b
TEST_AGENT_RELEASE_TOOLBOX_FINGERPRINT=35447da08f477dd02e458e4344be9bd870452dba12ba6db32d250c56e9f15040
