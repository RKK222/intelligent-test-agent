# 企业本地 OpenCode 客户端的受控输入（只影响客户端组件指纹，不含任何密钥内容）。
#
# 用途：与现场节点 env（`--env-file`）合并后一起传给 `package-release.sh`。
# 缺任何一项，算出的 `local client fingerprint` 都不等于现场已部署值，客户端会被判成 included
# （包体膨胀、并触发重新签发客户端），或在使用 `--local-client-baseline-file` 时直接断言失败。
#
# 这组输入在 2026-09-10 首次复原、并复现出现场指纹
# 4fabde17757bf6695deaafb0d501708cd6432b1296e29cedbefc55ad95f4023d
# （现场版本 20260907093905，manifest 8976c932…9ba3），现场基线文件见
# `20260910-client-20260907093905-deployed.env`。
#
# 注意：
# - `TEST_AGENT_LOCAL_CLIENT_SIGNING_PUBLIC_KEY` 入指纹的是**路径字符串**，必须是签发该批客户端时的
#   原机路径；reuse 模式不会读取该文件，本机构建机上该路径不存在也不影响。
# - `TEST_AGENT_LOCAL_CLIENT_PUBLIC_CAPABILITY_BUNDLE` 入指纹的是该文件的**内容摘要**，
#   因此路径可以按构建机调整，只要文件与本批次能力包逐字一致（本机在 enterprise-build-inputs 下）。
TEST_AGENT_LOCAL_CLIENT_DOWNLOAD_BASE_URL=http://mimo.sdc.cs.icbc:9996/downloads/local-opencode-client/
TEST_AGENT_LOCAL_CLIENT_SERVER_URL=http://mimo.sdc.cs.icbc:9996
TEST_AGENT_LOCAL_CLIENT_ALLOW_INSECURE_CONTROL=true
TEST_AGENT_LOCAL_CLIENT_VERSION=20260907093905
TEST_AGENT_LOCAL_CLIENT_PUBLIC_CONFIG_COMMIT=81605f245d1512e1ab0dd73812391f6da7d008b5
TEST_AGENT_LOCAL_CLIENT_PUBLIC_CAPABILITY_BUNDLE=/Users/guo/mimoclaw/enterprise-build-inputs/mac-build/.secure/public-capabilities-81605f245d1512e1ab0dd73812391f6da7d008b5.tar.gz
TEST_AGENT_LOCAL_CLIENT_JDK_LINUX_ARM64_GLIBC_SHA256=edf0da4debe7cf475dbe320d174d6eed81479eb363f41e38a2efb740428c603a
TEST_AGENT_LOCAL_CLIENT_OPENCODE_LINUX_ARM64_GLIBC_SHA256=eba87efba3976d533a24cca0316f8ef375b5f8e797c0a95c25ee919700b7ba35
TEST_AGENT_LOCAL_CLIENT_SIGNING_PUBLIC_KEY=/Users/kaka/Desktop/intelligent-test-agent/.secure/local-client-signing-public.pem
