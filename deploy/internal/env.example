# Copy this file to /data/testagent/config/docker.env before running the pure Docker worker script.

# Enterprise deployment base directory. Keep concrete child paths below instead of relying on dotenv expansion.
TEST_AGENT_BASE_DIR=/data/testagent

# Entity Nginx uses a separate /data/testagent/config/nginx.env; see nginx.env.example.

# Must match TEST_AGENT_OPENCODE_MANAGER_TOKEN used by the Java backend process.
TEST_AGENT_OPENCODE_MANAGER_TOKEN=REPLACE_MANAGER_TOKEN

# Java writes SYS_DATA_ROOT_DIR/.serverid and .serverhost under this host path.
TEST_AGENT_DATA_ROOT=/data/testagent/data

# External program mount. The worker image still has built-in fallback programs.
TEST_AGENT_PROGRAM_ROOT=/data/testagent/programs
# Independently deployed Python third-party packages, mounted read-only into worker.
TEST_AGENT_PYTHON_LIBS_ROOT=/data/testagent/python-libs
# Optional models.dev-compatible global catalog. When this key is omitted, the worker
# also auto-detects the same fixed path if the file exists. Never put provider tokens here.
# TEST_AGENT_OPENCODE_MODELS_FILE=/data/testagent/config/opencode-models.json

# Frontend dist build. Keep empty so domain and IP entries both use the current origin.
VITE_TEST_AGENT_API_BASE_URL=

# Local OpenCode client HTTP distribution. Generate the RSA or EC signing key
# outside the repository and keep the private key only on the external build host.
# Leave empty to generate one immutable Beijing-time yyyyMMddHHmmss version.
# Every included client upgrade must be greater than the deployed component-state version;
# unchanged/reused client components keep their existing version.
TEST_AGENT_LOCAL_CLIENT_VERSION=
# Required for an upgrade built into a fresh standalone output directory when no component-state
# file is available. Set it to the last actually deployed client version; leave empty only initially.
TEST_AGENT_LOCAL_CLIENT_MINIMUM_VERSION=
TEST_AGENT_LOCAL_CLIENT_SIGNING_KEY=/absolute/secure/path/local-client-signing-private.pem
# Optional; package-local-opencode-client.sh derives this from the private key when empty.
TEST_AGENT_LOCAL_CLIENT_SIGNING_PUBLIC_KEY=
# 当前企业现场经域名 :9996 提供 HTTP/WS；明文例外只能用于已批准的可信内网。
TEST_AGENT_LOCAL_CLIENT_DOWNLOAD_BASE_URL=http://mimo.sdc.cs.icbc:9996/downloads/local-opencode-client/
TEST_AGENT_LOCAL_CLIENT_SERVER_URL=http://mimo.sdc.cs.icbc:9996
TEST_AGENT_LOCAL_CLIENT_ALLOW_INSECURE_CONTROL=true
# The fixed upstream source URLs and SHA-256 values have audited defaults in the
# packaging script. Set *_ARCHIVE to approved pre-downloaded files for offline builds.
TEST_AGENT_LOCAL_CLIENT_JDK_LINUX_ARM64_GLIBC_ARCHIVE=
TEST_AGENT_LOCAL_CLIENT_OPENCODE_LINUX_ARM64_GLIBC_ARCHIVE=

# Model provider base URLs and tokens belong to the Java database configuration.
# Do not put TEST_AGENT_INTERNAL_PROXY_API_KEY or any upstream model token in docker.env.

# opencode worker image build.
TEST_AGENT_OPENCODE_WORKER_IMAGE=test-agent-opencode-worker:internal
PYTHON_VERSION=3.13.14
PYTHON_SOURCE_SIZE=23021880
PYTHON_SOURCE_SHA256=639e43243c620a308f968213df9e00f2f8f62332f7adbaa7a7eeb9783057c690
PYTHON_SOURCE_BASE_URL=https://mirrors.huaweicloud.com/python
# Build-time-only mirror for the separately packaged, hash-locked Python wheel set.
PYTHON_PACKAGE_INDEX_URL=https://mirrors.huaweicloud.com/repository/pypi/simple
OPENCODE_VERSION=1.18.4
OPENCODE_RELEASE_COMMIT=49c69c5ed3ccf706b61b3febb43c8aaff7f8325e
OPENCODE_ASSET_NAME=opencode-linux-x64-baseline.tar.gz
OPENCODE_ASSET_SIZE=59265643
OPENCODE_ASSET_SHA256=4d87e414607b77fef940256021e42fbbf37b8c62b06ced76b69e26c5dcbfbabc
OPENCODE_BINARY_SHA256=6ce6570e7db9a40e7bd3304ebdfff607920bde8cafd2eb5587bd7a26f89ba0b5
OPENCODE_RELEASE_BASE_URL=https://github.com/anomalyco/opencode/releases/download
CODEX_VERSION=0.145.0
CODEX_ASSET_NAME=codex-x86_64-unknown-linux-musl.tar.gz
CODEX_ASSET_SIZE=113724150
CODEX_ASSET_SHA256=bfaf13c9ba34f2ad764e4a916c49cf7177aeba329cf0f719e2227566fc8d662a
CODEX_BWRAP_ASSET_NAME=bwrap-x86_64-unknown-linux-musl.tar.gz
CODEX_BWRAP_ASSET_SIZE=261563
CODEX_BWRAP_ASSET_SHA256=bf829ae02652acdb13732e3b00b3e656baaa56be2a65d50309d676df2b5d7581
CODEX_BWRAP_BINARY_SHA256=77360cb751ccedc5971391444ac86a8a33c15b04d6b4a6fe45f5d25496e62c4c
CODEX_RELEASE_BASE_URL=https://github.com/openai/codex/releases/download
GO_IMAGE=golang@sha256:e87b2a5f6df2dff71ea330d55d54f4979eb380ae58a7e3aabc9d53121243e689
NODE_IMAGE=node@sha256:b042c6d46a90773b82ea3f95b05457ea93ee127a73b1b47ad5ebbb1a08ec3df8

# Worker port ranges must be the host-published ports Java will use in opencode baseUrl.
OPENCODE_WORKER_BACKEND_PORT=8080
OPENCODE_WORKER_PORT_START=4096
OPENCODE_WORKER_PORT_END=4115
OPENCODE_ALLOWED_CORS=http://mimo.sdc.cs.icbc:9996,http://122.233.30.2:9996
OPENCODE_MANAGER_HEARTBEAT_INTERVAL=5s
OPENCODE_MANAGER_RECONNECT_INTERVAL=10s

# Build mirrors.
NPM_REGISTRY=https://registry.npmmirror.com
COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=https://goproxy.cn,direct
DEBIAN_MIRROR=https://mirrors.ustc.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.ustc.edu.cn/debian-security

# Backend jar, frontend dist, external programs and image tarballs are written here by deploy/internal/package-release.sh.
TEST_AGENT_IMAGE_OUTPUT_DIR=/data/testagent/dist

# External fork build output consumed by --with-lobehub or --lobehub-only.
# The directory must contain release.env, SHA256SUMS, digest-pinned image tar files,
# signed Windows/Linux clients, source, SBOM, licenses and approval evidence.
TEST_AGENT_LOBEHUB_ARTIFACT_DIR=/absolute/path/to/lobehub-release-artifacts
