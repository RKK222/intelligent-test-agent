{
  // 合并到公共配置仓库的 opencode/opencode.jsonc。
  "mcp": {
    "code_analysis": {
      "type": "local",
      "command": [
        "/data/testagent/programs/codex/bin/test-agent-codex-mcp"
      ],
      "environment": {
        "TEST_AGENT_CODEX_PROVIDER_ID": "deepseek-prod",
        "TEST_AGENT_CODEX_MODEL": "DeepSeek-V4-Flash-W8A8",
        "TEST_AGENT_CODEX_CONTEXT_WINDOW": "262144"
      },
      "enabled": true,
      "timeout": 600000
    }
  }
}
