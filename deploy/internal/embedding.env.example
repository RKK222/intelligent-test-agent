# 安装后保存为 /data/testagent/config/embedding.env，权限必须为 0600。
TEST_AGENT_EMBEDDING_IMAGE=test-agent-embedding-bge-small-zh-v1.5:internal
TEST_AGENT_EMBEDDING_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TEST_AGENT_EMBEDDING_BIND_ADDRESS=0.0.0.0
TEST_AGENT_EMBEDDING_HOST_PORT=18989
TEST_AGENT_EMBEDDING_MAX_BATCH_SIZE=64
TEST_AGENT_EMBEDDING_MAX_INPUT_CHARS=8000
TEST_AGENT_EMBEDDING_MAX_BATCH_CHARS=120000
TEST_AGENT_EMBEDDING_MAX_CONCURRENCY=4
TEST_AGENT_EMBEDDING_QUEUE_TIMEOUT_SECONDS=2
TEST_AGENT_EMBEDDING_TORCH_THREADS=4
