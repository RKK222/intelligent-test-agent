# Copy to /data/testagent/config/toolbox.env on the dedicated toolbox node.

TEST_AGENT_TOOLBOX_IT_TOOLS_IMAGE=test-agent/it-tools:2024.10.22-7ca5933-platform.2
TEST_AGENT_TOOLBOX_OMNI_TOOLS_IMAGE=test-agent/omni-tools:0.6.0-platform.1
# 可在上述仓库名前增加企业 registry；脚本会拒绝 latest 或其它 platform tag。

# Keep 127.0.0.1 when Nginx is on the same host. On a dedicated node, use its private IP
# and configure the host firewall to allow TCP 18120/18121 only from the frontend Nginx host.
TEST_AGENT_TOOLBOX_BIND_ADDRESS=127.0.0.1
# 脚本会创建关闭 IP masquerade 的专用 bridge；不要预建为 Docker --internal 网络，
# 否则独立工具节点无法把 18120/18121 发布给前端 Nginx 主机。
TEST_AGENT_TOOLBOX_NETWORK=test-agent-toolbox
TEST_AGENT_TOOLBOX_ARTIFACT_DIR=/data/testagent/dist

TEST_AGENT_TOOLBOX_IT_TOOLS_TAR=/data/testagent/dist/test-agent_it-tools_2024.10.22-7ca5933-platform.2-linux-amd64.tar
TEST_AGENT_TOOLBOX_OMNI_TOOLS_TAR=/data/testagent/dist/test-agent_omni-tools_0.6.0-platform.1-linux-amd64.tar
