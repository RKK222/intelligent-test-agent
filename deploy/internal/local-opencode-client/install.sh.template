#!/usr/bin/env sh
set -eu

# 公钥、Nginx 下载根和平台控制根在外网 Mac 打包时固化；HTTP 只负责传输，信任来自签名。
PUBLIC_KEY_PEM_BASE64="__PUBLIC_KEY_PEM_BASE64__"
PUBLIC_KEY_DER_BASE64="__PUBLIC_KEY_DER_BASE64__"
DOWNLOAD_BASE_URL="__DOWNLOAD_BASE_URL__"
SERVER_URL="__SERVER_URL__"
ALLOW_INSECURE_CONTROL="__ALLOW_INSECURE_CONTROL__"
LAUNCHER_VERSION=1
APPLY_EXIT_CODE=42
ACTIVATION_FAILED_EXIT_CODE=43
LOG_FILE=""
CURRENT_STAGE="initialization"
SESSION_ID="trace_launcher_${LAUNCHER_VERSION}_$$"

# 启动器只记录受控阶段与签名制品元数据，不记录统一认证号、Client key、服务端正文或命令输出。
log_event() {
  log_level="$1"
  log_name="$2"
  shift 2
  [ -n "${LOG_FILE}" ] || return 0
  if command -v date >/dev/null 2>&1; then
    log_time="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  else
    log_time="unknown-time"
  fi
  # 环境变量或本地 marker 中的异常控制字符不能制造伪造日志行。
  safe_fields="$(printf '%s' "$*" | tr '\r\n\t' '___')"
  printf 'time=%s level=%s session=%s launcher=%s platform=linux architecture=arm64 stage=%s event=%s %s\n' \
    "${log_time}" "${log_level}" "${SESSION_ID}" "${LAUNCHER_VERSION}" \
    "${CURRENT_STAGE}" "${log_name}" "${safe_fields}" >>"${LOG_FILE}" 2>/dev/null || true
}

set_stage() {
  CURRENT_STAGE="$1"
  log_event INFO launcher_stage_started "stage=${CURRENT_STAGE}"
}

initialize_logging() {
  logs_directory="${STATE_DIR}/logs"
  mkdir -p "${logs_directory}"
  chmod 0700 "${logs_directory}"
  launcher_log="${logs_directory}/launcher.log"
  if [ -L "${launcher_log}" ]; then
    printf 'test-agent-local-client: 启动器日志不能是符号链接\n' >&2
    exit 1
  fi
  if [ -f "${launcher_log}" ] && [ "$(wc -c <"${launcher_log}" | tr -d '[:space:]')" -ge 5242880 ]; then
    rm -f "${logs_directory}/launcher-1.log"
    mv "${launcher_log}" "${logs_directory}/launcher-1.log"
  fi
  : >>"${launcher_log}"
  chmod 0600 "${launcher_log}"
  LOG_FILE="${launcher_log}"
}

fail() {
  log_event ERROR launcher_failed "stage=${CURRENT_STAGE} failureCode=LAUNCHER_STAGE_FAILED"
  printf 'test-agent-local-client: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "缺少必需命令: $1"
}

cleanup() {
  if [ -n "${TEMP_DIR:-}" ]; then
    case "${TEMP_DIR}" in
      */test-agent-local-client.*) rm -rf "${TEMP_DIR}" ;;
      *) printf '拒绝清理异常临时目录: %s\n' "${TEMP_DIR}" >&2 ;;
    esac
  fi
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    fail "缺少 sha256sum 或 shasum"
  fi
}

file_size() {
  wc -c <"$1" | tr -d '[:space:]'
}

file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null
}

valid_version() {
  [ "$(expr "$1" : '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$')" -eq 14 ]
}

safe_relative_path() {
  path_value="$1"
  expected_prefix="$2"
  case "${path_value}" in
    "${expected_prefix}"*) ;;
    *) return 1 ;;
  esac
  case "${path_value}" in
    /*|*\\*|*%*|*//*|../*|*/../*|*/..|./*|*/./*|*/.) return 1 ;;
  esac
  return 0
}

download_relative() {
  relative_path="$1"
  destination="$2"
  safe_relative_path "${relative_path}" "${EXPECTED_DOWNLOAD_PREFIX}" \
    || fail "签名元数据包含越界下载路径"
  curl -fS --max-redirs 0 --proto '=http' \
    "${DOWNLOAD_BASE_URL}${relative_path}" -o "${destination}"
}

manifest_string() {
  wanted_key="$1"
  awk -v wanted="\"${wanted_key}\"" '
    index($0, wanted) {
      line=$0
      sub(".*" wanted "[[:space:]]*:[[:space:]]*\"", "", line)
      sub("\".*", "", line)
      print line
      exit
    }
  ' "${MANIFEST_FILE}"
}

manifest_number() {
  wanted_key="$1"
  awk -v wanted="\"${wanted_key}\"" '
    index($0, wanted) {
      line=$0
      sub(".*" wanted "[[:space:]]*:[[:space:]]*", "", line)
      sub("[^0-9].*", "", line)
      print line
      exit
    }
  ' "${MANIFEST_FILE}"
}

artifact_string() {
  wanted_kind="$1"
  wanted_key="$2"
  awk -v kind="\"kind\": \"${wanted_kind}\"" -v wanted="\"${wanted_key}\"" '
    index($0, kind) && index($0, wanted) {
      line=$0
      sub(".*" wanted "[[:space:]]*:[[:space:]]*\"", "", line)
      sub("\".*", "", line)
      print line
      exit
    }
  ' "${MANIFEST_FILE}"
}

artifact_number() {
  wanted_kind="$1"
  wanted_key="$2"
  awk -v kind="\"kind\": \"${wanted_kind}\"" -v wanted="\"${wanted_key}\"" '
    index($0, kind) && index($0, wanted) {
      line=$0
      sub(".*" wanted "[[:space:]]*:[[:space:]]*", "", line)
      sub("[^0-9].*", "", line)
      print line
      exit
    }
  ' "${MANIFEST_FILE}"
}

property_value() {
  property_file="$1"
  property_key="$2"
  awk -F= -v wanted="${property_key}" '$1 == wanted { print substr($0, index($0, "=") + 1); exit }' "${property_file}"
}

java_major() {
  java_command="$1"
  "${java_command}" -version 2>&1 | awk -F'"' '
    /version/ {
      split($2, parts, ".")
      if (parts[1] == "1") print parts[2]; else print parts[1]
      exit
    }
  '
}

javac_major() {
  javac_command="$1"
  "${javac_command}" -version 2>&1 | awk '{ split($2, parts, "."); print parts[1]; exit }'
}

resolve_real_path() {
  resolved_path="$1"
  [ -e "${resolved_path}" ] || return 1
  while [ -L "${resolved_path}" ]; do
    link_target="$(readlink "${resolved_path}")" || return 1
    case "${link_target}" in
      /*) resolved_path="${link_target}" ;;
      *) resolved_path="$(dirname "${resolved_path}")/${link_target}" ;;
    esac
  done
  resolved_directory="$(cd -P "$(dirname "${resolved_path}")" && pwd -P)" || return 1
  printf '%s/%s\n' "${resolved_directory}" "$(basename "${resolved_path}")"
}

path_inside_root() {
  target_path="$1"
  root_path="$2"
  case "${target_path}" in
    "${root_path}"/*) return 0 ;;
    *) return 1 ;;
  esac
}

validate_jdk_tree() {
  jdk_root="$1"
  canonical_jdk_root="$(resolve_real_path "${jdk_root}")" || return 1
  [ -d "${canonical_jdk_root}" ] && [ ! -L "${canonical_jdk_root}" ] || return 1
  link_list="${TEMP_DIR}/jdk-links.$$"
  find "${canonical_jdk_root}" -type l -print >"${link_list}" || return 1
  while IFS= read -r jdk_link; do
    [ -n "${jdk_link}" ] || continue
    link_target="$(resolve_real_path "${jdk_link}")" || return 1
    path_inside_root "${link_target}" "${canonical_jdk_root}" || return 1
  done <"${link_list}"
}

system_jdk21_home() {
  java_command="$(command -v java 2>/dev/null || true)"
  javac_command="$(command -v javac 2>/dev/null || true)"
  [ -n "${java_command}" ] && [ -n "${javac_command}" ] || return 1
  java_path="$(resolve_real_path "${java_command}")" || return 1
  javac_path="$(resolve_real_path "${javac_command}")" || return 1
  jdk_home="$(cd -P "$(dirname "${java_path}")/.." && pwd -P)" || return 1
  canonical_jdk_home="$(resolve_real_path "${jdk_home}")" || return 1
  home_java="$(resolve_real_path "${jdk_home}/bin/java")" || return 1
  home_javac="$(resolve_real_path "${jdk_home}/bin/javac")" || return 1
  [ "${java_path}" = "${home_java}" ] && [ "${javac_path}" = "${home_javac}" ] || return 1
  path_inside_root "${java_path}" "${canonical_jdk_home}" || return 1
  path_inside_root "${javac_path}" "${canonical_jdk_home}" || return 1
  validate_jdk_tree "${canonical_jdk_home}" || return 1
  [ "$(java_major "${jdk_home}/bin/java")" = 21 ] || return 1
  [ "$(javac_major "${jdk_home}/bin/javac")" = 21 ] || return 1
  printf '%s\n' "${jdk_home}"
}

is_system_jdk_release() {
  release_directory="$1"
  marker_file="${release_directory}/jdk.provenance"
  [ -f "${marker_file}" ] && [ ! -L "${marker_file}" ] \
    && [ "$(file_size "${marker_file}")" = 20 ] \
    && printf '%s\n' 'source=system-jdk21' | cmp -s - "${marker_file}" \
    && [ ! -e "${release_directory}/jdk.tar.gz" ] && [ ! -L "${release_directory}/jdk.tar.gz" ] \
    && [ ! -e "${release_directory}/jdk.tar.gz.sig" ] && [ ! -L "${release_directory}/jdk.tar.gz.sig" ]
}

copy_system_jdk() {
  system_jdk_home="$1"
  staging_directory="$2"
  [ -d "${system_jdk_home}" ] && [ ! -L "${system_jdk_home}" ] \
    || fail "系统 JDK home 不安全"
  validate_jdk_tree "${system_jdk_home}" || fail "系统 JDK 包含越界链接"
  cp -RL "${system_jdk_home}" "${staging_directory}/jdk" \
    || fail "无法复制系统 JDK 到私有发布单元"
  chmod -R go-rwx "${staging_directory}/jdk" \
    || fail "无法收紧私有 JDK 权限"
  [ -x "${staging_directory}/jdk/bin/java" ] && [ -x "${staging_directory}/jdk/bin/javac" ] \
    || fail "复制后的系统 JDK 布局无效"
  [ "$(java_major "${staging_directory}/jdk/bin/java")" = 21 ] \
    && [ "$(javac_major "${staging_directory}/jdk/bin/javac")" = 21 ] \
    || fail "复制后的系统 JDK 主版本不是 21"
  validate_jdk_tree "${staging_directory}/jdk" || fail "私有 JDK 包含越界链接"
  # marker 只声明可信来源类型，不写入可识别用户环境的系统路径。
  printf '%s\n' 'source=system-jdk21' >"${staging_directory}/jdk.provenance"
  chmod 0600 "${staging_directory}/jdk.provenance"
}

verify_platform() {
  if [ "${TEST_AGENT_LOCAL_CLIENT_TEST_MODE:-false}" = true ]; then
    [ "${TEST_AGENT_LOCAL_CLIENT_TEST_PLATFORM:-}" = linux-arm64-glibc ] \
      || fail "测试平台覆盖值无效"
    return
  fi
  [ "$(uname -s)" = Linux ] || fail "本安装包仅支持麒麟 ARM64 Linux"
  case "$(uname -m)" in
    aarch64|arm64) ;;
    *) fail "本安装包仅支持 arm64/aarch64" ;;
  esac
  getconf GNU_LIBC_VERSION >/dev/null 2>&1 \
    || ldd --version 2>&1 | grep -Eqi 'glibc|GNU libc' \
    || fail "当前系统不是受支持的 glibc 环境"
}

verify_manifest() {
  expected_version="$1"
  EXPECTED_DOWNLOAD_PREFIX="releases/${expected_version}/"
  [ "$(manifest_number schemaVersion)" = 2 ] || fail "发布清单 schema 不受支持"
  [ "$(manifest_string version)" = "${expected_version}" ] || fail "发布清单版本不一致"
  [ "$(manifest_string platform)" = linux ] || fail "发布清单平台不兼容"
  [ "$(manifest_string architecture)" = arm64 ] || fail "发布清单架构不兼容"
  [ "$(manifest_string protocolVersion)" = local-opencode-client.v1 ] || fail "发布清单协议不兼容"
  [ "$(manifest_string opencodeVersion)" = 1.18.4 ] || fail "OpenCode 版本不兼容"
  launcher_min="$(manifest_number launcherVersionMin)"
  launcher_max="$(manifest_number launcherVersionMax)"
  [ -n "${launcher_min}" ] && [ -n "${launcher_max}" ] \
    && [ "${launcher_min}" -le "${LAUNCHER_VERSION}" ] \
    && [ "${launcher_max}" -ge "${LAUNCHER_VERSION}" ] \
    || fail "稳定启动器版本不兼容"
}

# 共享 catalog 可同时包含 Win10 和麒麟发布；稳定启动器只选择最新的 linux/arm64 兼容项。
select_latest_compatible_version() {
  candidate_versions="${TEMP_DIR}/catalog-versions.txt"
  awk -F'"' '$2 == "version" { print $4 }' "${catalog_file}" | sort -r -u >"${candidate_versions}"
  while IFS= read -r candidate_version; do
    valid_version "${candidate_version}" || fail "版本 catalog 包含非法版本"
    EXPECTED_DOWNLOAD_PREFIX="releases/${candidate_version}/"
    MANIFEST_FILE="${TEMP_DIR}/candidate-${candidate_version}.json"
    MANIFEST_SIGNATURE_FILE="${MANIFEST_FILE}.sig"
    download_relative "releases/${candidate_version}/manifest.json" "${MANIFEST_FILE}"
    download_relative "releases/${candidate_version}/manifest.json.sig" "${MANIFEST_SIGNATURE_FILE}"
    openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
      -signature "${MANIFEST_SIGNATURE_FILE}" "${MANIFEST_FILE}" >/dev/null \
      || fail "catalog 中的发布清单签名无效"
    launcher_min="$(manifest_number launcherVersionMin)"
    launcher_max="$(manifest_number launcherVersionMax)"
    if [ "$(manifest_number schemaVersion)" = 2 ] \
        && [ "$(manifest_string version)" = "${candidate_version}" ] \
        && [ "$(manifest_string platform)" = linux ] \
        && [ "$(manifest_string architecture)" = arm64 ] \
        && [ "$(manifest_string protocolVersion)" = local-opencode-client.v1 ] \
        && [ "$(manifest_string opencodeVersion)" = 1.18.4 ] \
        && [ -n "${launcher_min}" ] && [ -n "${launcher_max}" ] \
        && [ "${launcher_min}" -le "${LAUNCHER_VERSION}" ] \
        && [ "${launcher_max}" -ge "${LAUNCHER_VERSION}" ]; then
      printf '%s\n' "${candidate_version}"
      return 0
    fi
  done <"${candidate_versions}"
  return 1
}

read_artifact_metadata() {
  kind="$1"
  ARTIFACT_PATH="$(artifact_string "${kind}" path)"
  ARTIFACT_SIGNATURE_PATH="$(artifact_string "${kind}" signaturePath)"
  ARTIFACT_SHA="$(artifact_string "${kind}" sha256)"
  ARTIFACT_SIZE="$(artifact_number "${kind}" size)"
  safe_relative_path "${ARTIFACT_PATH}" "${EXPECTED_DOWNLOAD_PREFIX}" \
    || fail "${kind} 路径不受信任"
  safe_relative_path "${ARTIFACT_SIGNATURE_PATH}" "${EXPECTED_DOWNLOAD_PREFIX}" \
    || fail "${kind} 签名路径不受信任"
  valid_sha_length="$(expr "${ARTIFACT_SHA}" : '[0-9a-f][0-9a-f]*$')"
  [ "${valid_sha_length}" -eq 64 ] || fail "${kind} SHA-256 无效"
  case "${ARTIFACT_SIZE}" in ''|*[!0-9]*) fail "${kind} 大小无效" ;; esac
  [ "${ARTIFACT_SIZE}" -ge 1 ] && [ "${ARTIFACT_SIZE}" -le 4294967296 ] \
    || fail "${kind} 大小超限"
}

download_artifact() {
  kind="$1"
  local_name="$2"
  destination_root="$3"
  read_artifact_metadata "${kind}"
  log_event INFO launcher_artifact_download_started \
    "stage=${CURRENT_STAGE} kind=${kind} size=${ARTIFACT_SIZE} sha256=${ARTIFACT_SHA}"
  download_relative "${ARTIFACT_PATH}" "${destination_root}/${local_name}"
  download_relative "${ARTIFACT_SIGNATURE_PATH}" "${destination_root}/${local_name}.sig"
  [ "$(file_size "${destination_root}/${local_name}")" = "${ARTIFACT_SIZE}" ] \
    || fail "${kind} 文件大小与签名清单不一致"
  [ "$(sha256_file "${destination_root}/${local_name}")" = "${ARTIFACT_SHA}" ] \
    || fail "${kind} SHA-256 校验失败"
  openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
    -signature "${destination_root}/${local_name}.sig" \
    "${destination_root}/${local_name}" >/dev/null \
    || fail "${kind} 制品签名校验失败"
  log_event INFO launcher_artifact_ready \
    "stage=${CURRENT_STAGE} kind=${kind} source=download size=${ARTIFACT_SIZE} sha256=${ARTIFACT_SHA}"
}

# 内容缓存只按制品类型和 SHA-256 定位；每次命中仍用当前安装器公钥重新验签。
artifact_cache_entry_valid() {
  validated_cache_entry="$1"
  [ -d "${validated_cache_entry}" ] && [ ! -L "${validated_cache_entry}" ] \
    && [ -f "${validated_cache_entry}/artifact" ] && [ ! -L "${validated_cache_entry}/artifact" ] \
    && [ -f "${validated_cache_entry}/artifact.sig" ] && [ ! -L "${validated_cache_entry}/artifact.sig" ] \
    || return 1
  [ "$(file_size "${validated_cache_entry}/artifact")" = "${ARTIFACT_SIZE}" ] \
    && [ "$(sha256_file "${validated_cache_entry}/artifact")" = "${ARTIFACT_SHA}" ] \
    || return 1
  cached_signature_size="$(file_size "${validated_cache_entry}/artifact.sig")"
  [ "${cached_signature_size}" -ge 1 ] && [ "${cached_signature_size}" -le 16384 ] \
    || return 1
  openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
    -signature "${validated_cache_entry}/artifact.sig" \
    "${validated_cache_entry}/artifact" >/dev/null 2>&1
}

ensure_artifact_cache_directory() {
  cache_kind="$1"
  case "${cache_kind}" in
    CLIENT_JAR|JDK|OPENCODE|PUBLIC_CAPABILITIES) ;;
    *) fail "不支持的制品缓存类型: ${cache_kind}" ;;
  esac
  if [ -e "${ARTIFACT_CACHE_DIR}" ] || [ -L "${ARTIFACT_CACHE_DIR}" ]; then
    [ -d "${ARTIFACT_CACHE_DIR}" ] && [ ! -L "${ARTIFACT_CACHE_DIR}" ] \
      || fail "制品缓存根目录不安全"
    chmod 0700 "${ARTIFACT_CACHE_DIR}"
  else
    mkdir "${ARTIFACT_CACHE_DIR}" || fail "无法创建制品缓存根目录"
    chmod 0700 "${ARTIFACT_CACHE_DIR}"
  fi
  cache_kind_directory="${ARTIFACT_CACHE_DIR}/${cache_kind}"
  if [ -e "${cache_kind_directory}" ] || [ -L "${cache_kind_directory}" ]; then
    [ -d "${cache_kind_directory}" ] && [ ! -L "${cache_kind_directory}" ] \
      || fail "${cache_kind} 制品缓存目录不安全"
    chmod 0700 "${cache_kind_directory}"
  else
    mkdir "${cache_kind_directory}" || fail "无法创建 ${cache_kind} 制品缓存目录"
    chmod 0700 "${cache_kind_directory}"
  fi
}

reuse_cached_artifact() {
  cache_kind="$1"
  cache_local_name="$2"
  cache_destination_root="$3"
  read_artifact_metadata "${cache_kind}"
  [ -d "${ARTIFACT_CACHE_DIR}" ] && [ ! -L "${ARTIFACT_CACHE_DIR}" ] || return 1
  cache_kind_directory="${ARTIFACT_CACHE_DIR}/${cache_kind}"
  [ -d "${cache_kind_directory}" ] && [ ! -L "${cache_kind_directory}" ] || return 1
  cache_entry="${cache_kind_directory}/${ARTIFACT_SHA}"
  artifact_cache_entry_valid "${cache_entry}" || return 1
  cp "${cache_entry}/artifact" "${cache_destination_root}/${cache_local_name}" \
    && cp "${cache_entry}/artifact.sig" "${cache_destination_root}/${cache_local_name}.sig" \
    || fail "无法复用 ${cache_kind} 内容缓存"
  chmod 0600 "${cache_destination_root}/${cache_local_name}" \
    "${cache_destination_root}/${cache_local_name}.sig"
  log_event INFO launcher_artifact_ready \
    "stage=${CURRENT_STAGE} kind=${cache_kind} source=content_cache size=${ARTIFACT_SIZE} sha256=${ARTIFACT_SHA}"
  printf '复用已校验的 %s 内容缓存。\n' "${cache_kind}"
}

cache_signed_artifact() {
  cache_kind="$1"
  cache_local_name="$2"
  cache_source_root="$3"
  read_artifact_metadata "${cache_kind}"
  cache_source_file="${cache_source_root}/${cache_local_name}"
  cache_source_signature="${cache_source_file}.sig"
  [ -f "${cache_source_file}" ] && [ ! -L "${cache_source_file}" ] \
    && [ -f "${cache_source_signature}" ] && [ ! -L "${cache_source_signature}" ] \
    || fail "${cache_kind} 已验签制品不存在"
  [ "$(file_size "${cache_source_file}")" = "${ARTIFACT_SIZE}" ] \
    && [ "$(sha256_file "${cache_source_file}")" = "${ARTIFACT_SHA}" ] \
    || fail "${cache_kind} 制品不能写入内容缓存"
  openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
    -signature "${cache_source_signature}" "${cache_source_file}" >/dev/null 2>&1 \
    || fail "${cache_kind} 制品写入缓存前验签失败"

  ensure_artifact_cache_directory "${cache_kind}"
  cache_entry="${cache_kind_directory}/${ARTIFACT_SHA}"
  if artifact_cache_entry_valid "${cache_entry}"; then
    return 0
  fi
  cache_staging="${ARTIFACT_CACHE_DIR}/.prepare-$$-${cache_kind}-${ARTIFACT_SHA}"
  [ ! -e "${cache_staging}" ] && [ ! -L "${cache_staging}" ] \
    || fail "制品缓存暂存目录冲突"
  mkdir "${cache_staging}" || fail "无法创建制品缓存暂存目录"
  chmod 0700 "${cache_staging}"
  cp "${cache_source_file}" "${cache_staging}/artifact" \
    && cp "${cache_source_signature}" "${cache_staging}/artifact.sig" \
    || fail "无法写入 ${cache_kind} 制品缓存"
  chmod 0600 "${cache_staging}/artifact" "${cache_staging}/artifact.sig"
  artifact_cache_entry_valid "${cache_staging}" \
    || fail "${cache_kind} 制品缓存暂存校验失败"
  if [ -e "${cache_entry}" ] || [ -L "${cache_entry}" ]; then
    # 目标由受信 kind 和 64 位小写 SHA 构成，只移除这一条损坏缓存。
    rm -rf "${cache_entry}"
  fi
  mv "${cache_staging}" "${cache_entry}" || fail "无法发布 ${cache_kind} 制品缓存"
}

# release 目录只是旧安装首次升级时的迁移来源，不再是跨版本复用的长期前提。
reuse_signed_artifact() {
  reuse_kind="$1"
  reuse_local_name="$2"
  reuse_source_root="$3"
  reuse_destination_root="$4"
  [ -n "${reuse_source_root}" ] && [ -d "${reuse_source_root}" ] && [ ! -L "${reuse_source_root}" ] \
    || return 1
  reuse_source_file="${reuse_source_root}/${reuse_local_name}"
  reuse_source_signature="${reuse_source_file}.sig"
  [ -f "${reuse_source_file}" ] && [ ! -L "${reuse_source_file}" ] \
    && [ -f "${reuse_source_signature}" ] && [ ! -L "${reuse_source_signature}" ] \
    || return 1
  read_artifact_metadata "${reuse_kind}"
  [ "$(file_size "${reuse_source_file}")" = "${ARTIFACT_SIZE}" ] \
    && [ "$(sha256_file "${reuse_source_file}")" = "${ARTIFACT_SHA}" ] \
    || return 1
  openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
    -signature "${reuse_source_signature}" "${reuse_source_file}" >/dev/null 2>&1 \
    || return 1
  cp "${reuse_source_file}" "${reuse_destination_root}/${reuse_local_name}" \
    && cp "${reuse_source_signature}" "${reuse_destination_root}/${reuse_local_name}.sig" \
    || fail "无法复用 ${reuse_kind} 本机缓存"
  chmod 0600 "${reuse_destination_root}/${reuse_local_name}" \
    "${reuse_destination_root}/${reuse_local_name}.sig"
  log_event INFO launcher_artifact_ready \
    "stage=${CURRENT_STAGE} kind=${reuse_kind} source=existing_release size=${ARTIFACT_SIZE} sha256=${ARTIFACT_SHA}"
  printf '从旧 release 迁移已校验的 %s 制品。\n' "${reuse_kind}"
}

obtain_artifact() {
  obtain_kind="$1"
  obtain_local_name="$2"
  obtain_source_root="$3"
  obtain_destination_root="$4"
  if reuse_cached_artifact \
      "${obtain_kind}" "${obtain_local_name}" "${obtain_destination_root}"; then
    return 0
  fi
  if reuse_signed_artifact \
      "${obtain_kind}" "${obtain_local_name}" "${obtain_source_root}" "${obtain_destination_root}"; then
    cache_signed_artifact "${obtain_kind}" "${obtain_local_name}" "${obtain_destination_root}"
    return 0
  fi
  download_artifact "${obtain_kind}" "${obtain_local_name}" "${obtain_destination_root}"
  cache_signed_artifact "${obtain_kind}" "${obtain_local_name}" "${obtain_destination_root}"
}

populate_artifact_cache_from_release() {
  cache_release_root="$1"
  for cache_kind_and_name in \
      'CLIENT_JAR test-agent-local-client.jar' \
      'JDK jdk.tar.gz' \
      'OPENCODE opencode.tar.gz' \
      'PUBLIC_CAPABILITIES public-capabilities.tar.gz'; do
    set -- ${cache_kind_and_name}
    [ -n "$(artifact_string "$1" path)" ] || continue
    [ -f "${cache_release_root}/$2" ] && [ -f "${cache_release_root}/$2.sig" ] || continue
    cache_signed_artifact "$1" "$2" "${cache_release_root}"
  done
}

verify_release_directory() {
  release_directory="$1"
  expected_digest="$2"
  MANIFEST_FILE="${release_directory}/manifest.json"
  MANIFEST_SIGNATURE_FILE="${release_directory}/manifest.json.sig"
  [ -f "${MANIFEST_FILE}" ] && [ ! -L "${MANIFEST_FILE}" ] \
    && [ -f "${MANIFEST_SIGNATURE_FILE}" ] && [ ! -L "${MANIFEST_SIGNATURE_FILE}" ] \
    || fail "发布目录缺少常规清单文件"
  release_version="$(basename "${release_directory}")"
  valid_version "${release_version}" || fail "发布目录版本无效"
  openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
    -signature "${MANIFEST_SIGNATURE_FILE}" "${MANIFEST_FILE}" >/dev/null \
    || fail "本地发布清单签名无效"
  [ -z "${expected_digest}" ] || [ "$(sha256_file "${MANIFEST_FILE}")" = "${expected_digest}" ] \
    || fail "本地发布清单摘要与 PREPARED 不一致"
  verify_manifest "${release_version}"
  for kind_and_name in 'CLIENT_JAR test-agent-local-client.jar' 'JDK jdk.tar.gz' 'OPENCODE opencode.tar.gz'; do
    set -- ${kind_and_name}
    artifact_path="$(artifact_string "$1" path)"
    artifact_sha="$(artifact_string "$1" sha256)"
    artifact_size="$(artifact_number "$1" size)"
    artifact_signature_path="$(artifact_string "$1" signaturePath)"
    safe_relative_path "${artifact_path}" "${EXPECTED_DOWNLOAD_PREFIX}" || fail "本地制品路径无效"
    safe_relative_path "${artifact_signature_path}" "${EXPECTED_DOWNLOAD_PREFIX}" || fail "本地签名路径无效"
    if [ "$1" = JDK ] && is_system_jdk_release "${release_directory}"; then
      # 初装时复制的系统 JDK 没有签名归档；其余已签名制品仍逐项校验。
      continue
    fi
    [ "$(file_size "${release_directory}/$2")" = "${artifact_size}" ] || fail "本地制品大小变化"
    [ "$(sha256_file "${release_directory}/$2")" = "${artifact_sha}" ] || fail "本地制品摘要变化"
    openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
      -signature "${release_directory}/$2.sig" "${release_directory}/$2" >/dev/null \
      || fail "本地制品签名无效"
  done
  # 旧 release 的签名清单没有公共能力制品，仍允许作为回退版本继续运行；
  # 新 release 一旦声明该制品，就必须像其它运行制品一样逐项校验。
  public_capability_path="$(artifact_string PUBLIC_CAPABILITIES path)"
  if [ -n "${public_capability_path}" ]; then
    public_capability_sha="$(artifact_string PUBLIC_CAPABILITIES sha256)"
    public_capability_size="$(artifact_number PUBLIC_CAPABILITIES size)"
    public_capability_signature_path="$(artifact_string PUBLIC_CAPABILITIES signaturePath)"
    safe_relative_path "${public_capability_path}" "${EXPECTED_DOWNLOAD_PREFIX}" \
      || fail "本地公共能力制品路径无效"
    safe_relative_path "${public_capability_signature_path}" "${EXPECTED_DOWNLOAD_PREFIX}" \
      || fail "本地公共能力签名路径无效"
    [ "$(file_size "${release_directory}/public-capabilities.tar.gz")" = "${public_capability_size}" ] \
      || fail "本地公共能力制品大小变化"
    [ "$(sha256_file "${release_directory}/public-capabilities.tar.gz")" = "${public_capability_sha}" ] \
      || fail "本地公共能力制品摘要变化"
    openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
      -signature "${release_directory}/public-capabilities.tar.gz.sig" \
      "${release_directory}/public-capabilities.tar.gz" >/dev/null \
      || fail "本地公共能力制品签名无效"
  fi
  [ -x "${release_directory}/jdk/bin/java" ] \
    && [ -x "${release_directory}/jdk/bin/javac" ] \
    && [ -x "${release_directory}/opencode/bin/opencode" ] \
    || fail "发布单元运行布局不完整"
  [ "$(java_major "${release_directory}/jdk/bin/java")" = 21 ] \
    && [ "$(javac_major "${release_directory}/jdk/bin/javac")" = 21 ] \
    || fail "发布单元不是完整 JDK 21"
}

bootstrap_release() {
  set_stage catalog_download
  mkdir -p "${RELEASES_DIR}"
  catalog_file="${TEMP_DIR}/catalog.json"
  catalog_signature="${TEMP_DIR}/catalog.json.sig"
  EXPECTED_DOWNLOAD_PREFIX=""
  curl -fS --max-redirs 0 --proto '=http' "${DOWNLOAD_BASE_URL}catalog.json" -o "${catalog_file}"
  curl -fS --max-redirs 0 --proto '=http' "${DOWNLOAD_BASE_URL}catalog.json.sig" -o "${catalog_signature}"
  [ "$(file_size "${catalog_file}")" -le 1048576 ] || fail "版本 catalog 超过大小上限"
  openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
    -signature "${catalog_signature}" "${catalog_file}" >/dev/null \
    || fail "版本 catalog 签名校验失败"
  log_event INFO launcher_catalog_verified "stage=${CURRENT_STAGE} size=$(file_size "${catalog_file}")"
  set_stage release_selection
  version="$(select_latest_compatible_version)" || fail "版本 catalog 没有兼容的麒麟 ARM64 发布"
  log_event INFO launcher_release_selected "stage=${CURRENT_STAGE} targetVersion=${version}"
  final_directory="${RELEASES_DIR}/${version}"
  if [ -d "${final_directory}" ]; then
    set_stage installed_release_verification
    verify_release_directory "${final_directory}" ""
    populate_artifact_cache_from_release "${final_directory}"
    log_event INFO launcher_release_ready "stage=${CURRENT_STAGE} targetVersion=${version} source=installed_release"
  else
    set_stage release_preparation
    cached_release_directory=""
    if cached_version="$(current_version 2>/dev/null)" && valid_version "${cached_version}"; then
      cached_candidate="${RELEASES_DIR}/${cached_version}"
      if [ -d "${cached_candidate}" ] && [ ! -L "${cached_candidate}" ]; then
        cached_release_directory="${cached_candidate}"
      fi
    fi
    staging_parent="${RELEASES_DIR}/.bootstrap-$$"
    staging_directory="${staging_parent}/${version}"
    mkdir -p "${staging_directory}"
    EXPECTED_DOWNLOAD_PREFIX="releases/${version}/"
    MANIFEST_FILE="${staging_directory}/manifest.json"
    MANIFEST_SIGNATURE_FILE="${staging_directory}/manifest.json.sig"
    download_relative "releases/${version}/manifest.json" "${MANIFEST_FILE}"
    download_relative "releases/${version}/manifest.json.sig" "${MANIFEST_SIGNATURE_FILE}"
    openssl dgst -sha256 -verify "${PUBLIC_KEY_FILE}" \
      -signature "${MANIFEST_SIGNATURE_FILE}" "${MANIFEST_FILE}" >/dev/null \
      || fail "发布清单签名校验失败"
    verify_manifest "${version}"
    if system_jdk_home="$(system_jdk21_home)"; then
      printf '检测到完整系统 JDK 21；复制到私有发布单元。\n'
      copy_system_jdk "${system_jdk_home}" "${staging_directory}"
    else
      printf '未检测到完整 JDK 21，准备签名 ARM64 JDK。\n'
      obtain_artifact JDK jdk.tar.gz "${cached_release_directory}" "${staging_directory}"
      tar -C "${staging_directory}" -xzf "${staging_directory}/jdk.tar.gz"
      [ -x "${staging_directory}/jdk/bin/java" ] && [ -x "${staging_directory}/jdk/bin/javac" ] \
        || fail "JDK 归档布局无效"
      [ "$(java_major "${staging_directory}/jdk/bin/java")" = 21 ] \
        && [ "$(javac_major "${staging_directory}/jdk/bin/javac")" = 21 ] \
        || fail "下载的 JDK 主版本不是 21"
    fi
    obtain_artifact CLIENT_JAR test-agent-local-client.jar "${cached_release_directory}" "${staging_directory}"
    obtain_artifact OPENCODE opencode.tar.gz "${cached_release_directory}" "${staging_directory}"
    if [ -n "$(artifact_string PUBLIC_CAPABILITIES path)" ]; then
      obtain_artifact PUBLIC_CAPABILITIES public-capabilities.tar.gz \
        "${cached_release_directory}" "${staging_directory}"
    fi
    tar -C "${staging_directory}" -xzf "${staging_directory}/opencode.tar.gz"
    [ -x "${staging_directory}/opencode/bin/opencode" ] || fail "OpenCode 归档布局无效"
    TEST_AGENT_LOCAL_CLIENT_CONFIG_DIR="${CONFIG_DIR}" \
    TEST_AGENT_LOCAL_CLIENT_STATE_DIR="${STATE_DIR}" \
    "${staging_directory}/jdk/bin/java" -jar \
      "${staging_directory}/test-agent-local-client.jar" \
      self-check "${staging_directory}" "${version}" >/dev/null \
      || fail "候选客户端本机自检失败"
    log_event INFO launcher_candidate_self_check_completed "stage=${CURRENT_STAGE} targetVersion=${version}"
    verify_release_directory "${staging_directory}" ""
    mv "${staging_directory}" "${final_directory}"
    rmdir "${staging_parent}"
    log_event INFO launcher_release_ready "stage=${CURRENT_STAGE} targetVersion=${version} source=new_release"
  fi
  set_stage release_switch
  switch_current "${version}"
  log_event INFO launcher_release_switched "stage=${CURRENT_STAGE} targetVersion=${version}"
}

switch_current() {
  switch_version="$1"
  valid_version "${switch_version}" || fail "拒绝切换到非法版本"
  [ -d "${RELEASES_DIR}/${switch_version}" ] || fail "目标发布目录不存在"
  ln -s "releases/${switch_version}" "${INSTALL_ROOT}/.current.$$"
  # GNU mv 使用 -T、BSD mv 使用 -h，均禁止跟随指向目录的旧 current 链接。
  if ! mv -fT "${INSTALL_ROOT}/.current.$$" "${INSTALL_ROOT}/current" 2>/dev/null; then
    mv -fh "${INSTALL_ROOT}/.current.$$" "${INSTALL_ROOT}/current"
  fi
}

current_version() {
  current_target="$(readlink "${INSTALL_ROOT}/current" 2>/dev/null || true)"
  case "${current_target}" in
    releases/*) basename "${current_target}" ;;
    *) return 1 ;;
  esac
}

ensure_configuration() {
  mkdir -p "${CONFIG_DIR}" "${STATE_DIR}" "${STATE_DIR}/logs"
  chmod 0700 "${CONFIG_DIR}" "${STATE_DIR}"
  {
    printf 'serverUrl=%s\n' "${SERVER_URL}"
    printf 'clientName=%s@%s\n' "${USER:-user}" "$(hostname 2>/dev/null || printf local)"
    printf 'opencodeExecutable=%s/current/opencode/bin/opencode\n' "${INSTALL_ROOT}"
    printf 'opencodeConfigDirectory=%s/opencode-config\n' "${CONFIG_DIR}"
    printf 'opencodeDataDirectory=%s/opencode-data\n' "${STATE_DIR}"
    printf 'portMin=4096\nportMax=4195\nallowInsecureControl=%s\n' "${ALLOW_INSECURE_CONTROL}"
    printf 'downloadBaseUrl=%s\n' "${DOWNLOAD_BASE_URL}"
    printf 'signingPublicKeyBase64=%s\n' "${PUBLIC_KEY_DER_BASE64}"
    printf 'installRoot=%s\n' "${INSTALL_ROOT}"
  } >"${CONFIG_DIR}/client.properties"
  chmod 0600 "${CONFIG_DIR}/client.properties"
}

ensure_runtime() {
  set_stage runtime_verification
  if [ ! -L "${INSTALL_ROOT}/current" ]; then
    bootstrap_release
    set_stage runtime_verification
  fi
  active_version="$(current_version)" || fail "current 不是受控发布链接"
  verify_release_directory "${RELEASES_DIR}/${active_version}" ""
  ensure_configuration
  log_event INFO launcher_runtime_ready "stage=${CURRENT_STAGE} activeVersion=${active_version}"
}

enroll_client() {
  active_version="$(current_version)"
  set_stage enrollment
  log_event INFO launcher_enrollment_started "stage=${CURRENT_STAGE} activeVersion=${active_version}"
  TEST_AGENT_LOCAL_CLIENT_CONFIG_DIR="${CONFIG_DIR}" \
  TEST_AGENT_LOCAL_CLIENT_STATE_DIR="${STATE_DIR}" \
  "${RELEASES_DIR}/${active_version}/jdk/bin/java" -jar \
    "${RELEASES_DIR}/${active_version}/test-agent-local-client.jar" enroll
  [ -f "${CONFIG_DIR}/credentials.properties" ] || fail "接入成功后未生成凭据文件"
  [ "$(file_mode "${CONFIG_DIR}/credentials.properties")" = 600 ] \
    || fail "凭据文件权限必须为 0600"
  log_event INFO launcher_enrollment_completed "stage=${CURRENT_STAGE} activeVersion=${active_version}"
}

ensure_enrolled() {
  re_enrollment_marker="${STATE_DIR}/re-enrollment-required"
  [ ! -L "${re_enrollment_marker}" ] || fail "重新接入标记不能是符号链接"
  if [ -e "${re_enrollment_marker}" ] && [ ! -f "${re_enrollment_marker}" ]; then
    fail "重新接入标记必须是普通文件"
  fi
  if [ -f "${CONFIG_DIR}/credentials.properties" ] && [ ! -f "${re_enrollment_marker}" ]; then
    return 0
  fi
  enroll_client
  rm -f "${re_enrollment_marker}"
}

install_user_service() {
  if [ "${TEST_AGENT_LOCAL_CLIENT_SKIP_SERVICE_START:-false}" = true ]; then
    log_event INFO launcher_service_skipped "stage=service_install reason=test_override"
    return 0
  fi
  set_stage service_install
  unit_dir="${HOME}/.config/systemd/user"
  desktop_dir="${HOME}/.local/share/applications"
  launcher_dir="${HOME}/.local/bin"
  service_launcher="${launcher_dir}/test-agent-local-client"
  launcher_source="$0"
  case "${launcher_source}" in
    */*) ;;
    *)
      if [ -f "${launcher_source}" ]; then
        launcher_source="./${launcher_source}"
      else
        launcher_source="$(command -v "${launcher_source}" 2>/dev/null || true)"
      fi
      ;;
  esac
  launcher_source="$(resolve_real_path "${launcher_source}")" \
    || fail "无法定位当前客户端安装脚本"
  mkdir -p "${launcher_dir}"
  if [ ! -f "${service_launcher}" ] || [ -L "${service_launcher}" ] \
    || ! cmp -s "${launcher_source}" "${service_launcher}"; then
    launcher_temp="${launcher_dir}/.test-agent-local-client.$$"
    cp "${launcher_source}" "${launcher_temp}"
    chmod 0755 "${launcher_temp}"
    mv -f "${launcher_temp}" "${service_launcher}"
  fi
  [ -x "${service_launcher}" ] && [ ! -L "${service_launcher}" ] \
    || fail "用户级客户端启动器安装失败"
  mkdir -p "${unit_dir}" "${desktop_dir}"
  {
    printf '%s\n' '[Unit]' 'Description=Test Agent Local OpenCode Client' \
      'After=network-online.target' 'Wants=network-online.target' '' '[Service]'
    printf 'ExecStart=%s run\n' "${service_launcher}"
    printf '%s\n' \
      'Restart=on-failure' 'RestartSec=3' 'SuccessExitStatus=0' '' '[Install]' \
      'WantedBy=default.target'
  } >"${unit_dir}/test-agent-local-opencode-client.service"
  chmod 0600 "${unit_dir}/test-agent-local-opencode-client.service"
  {
    printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Test Agent 本地客户端' \
      'Comment=启动或重新连接 TestAgent 平台；凭据失效时重新接入'
    printf 'Exec=%s start\n' "${service_launcher}"
    printf '%s\n' 'Icon=test-agent-local-client' 'Terminal=true' \
      'Categories=Development;Utility;'
  } >"${desktop_dir}/test-agent-local-client.desktop"
  chmod 0600 "${desktop_dir}/test-agent-local-client.desktop"
  systemctl --user daemon-reload
  systemctl --user enable test-agent-local-opencode-client.service
  systemctl --user restart test-agent-local-opencode-client.service
  log_event INFO launcher_service_installed "stage=${CURRENT_STAGE} service=test-agent-local-opencode-client.service"
}

validate_pending() {
  PENDING_FILE="${STATE_DIR}/pending-update.properties"
  [ -f "${PENDING_FILE}" ] && [ ! -L "${PENDING_FILE}" ] || fail "更新 pending marker 不安全"
  [ "$(file_mode "${PENDING_FILE}")" = 600 ] || fail "更新 pending marker 权限必须为 0600"
  pending_current="$(property_value "${PENDING_FILE}" currentVersion)"
  pending_target="$(property_value "${PENDING_FILE}" targetVersion)"
  pending_direction="$(property_value "${PENDING_FILE}" direction)"
  pending_digest="$(property_value "${PENDING_FILE}" releaseDigest)"
  valid_version "${pending_current}" && valid_version "${pending_target}" \
    || fail "更新 marker 版本无效"
  [ "$(expr "${pending_digest}" : '[0-9a-f][0-9a-f]*$')" -eq 64 ] \
    || fail "更新 marker 摘要无效"
  case "${pending_direction}" in
    UPDATE) [ "${pending_target}" \> "${pending_current}" ] || fail "更新方向与版本不一致" ;;
    ROLLBACK) [ "${pending_target}" \< "${pending_current}" ] || fail "回退方向与版本不一致" ;;
    *) fail "更新 marker 方向无效" ;;
  esac
}

write_update_result() {
  result_status="$1"
  result_error="$2"
  result_version="$3"
  result_file="${STATE_DIR}/update-result.properties"
  result_temp="${STATE_DIR}/.update-result.$$"
  cp "${PENDING_FILE}" "${result_temp}"
  {
    printf 'status=%s\n' "${result_status}"
    printf 'errorCode=%s\n' "${result_error}"
    printf 'actualVersion=%s\n' "${result_version}"
    printf 'observedAt=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >>"${result_temp}"
  chmod 0600 "${result_temp}"
  mv -f "${result_temp}" "${result_file}"
}

prepare_pending_switch() {
  set_stage update_switch
  validate_pending
  [ "$(current_version)" = "${pending_current}" ] || fail "更新 marker 的当前版本已失效"
  verify_release_directory "${RELEASES_DIR}/${pending_target}" "${pending_digest}"
  rm -f "${STATE_DIR}/update-activation.properties" "${STATE_DIR}/update-result.properties"
  switch_current "${pending_target}"
  log_event INFO launcher_update_switched \
    "stage=${CURRENT_STAGE} currentVersion=${pending_current} targetVersion=${pending_target} direction=${pending_direction}"
}

rollback_pending() {
  rollback_error="$1"
  validate_pending
  set_stage update_rollback
  verify_release_directory "${RELEASES_DIR}/${pending_current}" ""
  switch_current "${pending_current}"
  write_update_result AUTO_ROLLED_BACK "${rollback_error}" "${pending_current}"
  rm -f "${STATE_DIR}/update-activation.properties"
  log_event WARN launcher_update_rolled_back \
    "stage=${CURRENT_STAGE} restoredVersion=${pending_current} errorCode=${rollback_error}"
  printf '目标版本本机启动失败，已自动恢复到 %s。\n' "${pending_current}" >&2
}

run_activation_process() {
  active_version="$(current_version)"
  set_stage update_activation
  log_event INFO launcher_activation_started "stage=${CURRENT_STAGE} targetVersion=${active_version} timeoutSeconds=${TEST_AGENT_LOCAL_CLIENT_ACTIVATION_TIMEOUT_SECONDS:-70}"
  active_release="${RELEASES_DIR}/${active_version}"
  TEST_AGENT_LOCAL_CLIENT_CONFIG_DIR="${CONFIG_DIR}" \
  TEST_AGENT_LOCAL_CLIENT_STATE_DIR="${STATE_DIR}" \
  "${active_release}/jdk/bin/java" -jar "${active_release}/test-agent-local-client.jar" &
  client_pid="$!"
  timeout_seconds="${TEST_AGENT_LOCAL_CLIENT_ACTIVATION_TIMEOUT_SECONDS:-70}"
  elapsed=0
  while kill -0 "${client_pid}" >/dev/null 2>&1; do
    activation_file="${STATE_DIR}/update-activation.properties"
    if [ -f "${activation_file}" ] && [ ! -L "${activation_file}" ]; then
      activation_status="$(property_value "${activation_file}" status)"
      activation_error="$(property_value "${activation_file}" errorCode)"
      activation_version="$(property_value "${activation_file}" actualVersion)"
      [ "${activation_version}" = "${pending_target}" ] || fail "激活 marker 版本不一致"
      case "${activation_status}" in
        READY)
          write_update_result SUCCEEDED "" "${pending_target}"
          set +e
          wait "${client_pid}"
          activation_rc="$?"
          set -e
          log_event INFO launcher_activation_ready \
            "stage=${CURRENT_STAGE} targetVersion=${pending_target} clientExitCode=${activation_rc} elapsedSeconds=${elapsed}"
          return "${activation_rc}"
          ;;
        FAILED)
          kill "${client_pid}" >/dev/null 2>&1 || true
          wait "${client_pid}" >/dev/null 2>&1 || true
          rollback_pending "${activation_error:-TARGET_ACTIVATION_FAILED}"
          return 99
          ;;
        *) fail "激活 marker 状态无效" ;;
      esac
    fi
    [ "${elapsed}" -lt "${timeout_seconds}" ] || {
      kill "${client_pid}" >/dev/null 2>&1 || true
      wait "${client_pid}" >/dev/null 2>&1 || true
      rollback_pending TARGET_ACTIVATION_TIMEOUT
      return 99
    }
    sleep 1
    elapsed=$((elapsed + 1))
  done
  set +e
  wait "${client_pid}"
  activation_rc="$?"
  set -e
  rollback_pending TARGET_ACTIVATION_FAILED
  return 99
}

run_client() {
  set_stage managed_run
  ensure_runtime
  [ -f "${CONFIG_DIR}/credentials.properties" ] \
    || fail "尚未接入，请先在终端运行 test-agent-local-client enroll"
  while :; do
    active_version="$(current_version)"
    if [ -f "${STATE_DIR}/pending-update.properties" ] \
      && [ ! -f "${STATE_DIR}/update-result.properties" ]; then
      validate_pending
      if [ "${active_version}" = "${pending_target}" ]; then
        set +e
        run_activation_process
        client_rc="$?"
        set -e
        [ "${client_rc}" -eq 99 ] && continue
      else
        client_rc=0
      fi
    else
      active_release="${RELEASES_DIR}/${active_version}"
      log_event INFO launcher_client_process_started "stage=managed_run activeVersion=${active_version}"
      set +e
      TEST_AGENT_LOCAL_CLIENT_CONFIG_DIR="${CONFIG_DIR}" \
      TEST_AGENT_LOCAL_CLIENT_STATE_DIR="${STATE_DIR}" \
      "${active_release}/jdk/bin/java" -jar "${active_release}/test-agent-local-client.jar"
      client_rc="$?"
      set -e
      log_event INFO launcher_client_process_exited "stage=managed_run activeVersion=${active_version} exitCode=${client_rc}"
    fi
    case "${client_rc}" in
      "${APPLY_EXIT_CODE}") prepare_pending_switch ;;
      "${ACTIVATION_FAILED_EXIT_CODE}") rollback_pending TARGET_ACTIVATION_FAILED ;;
      *) return "${client_rc}" ;;
    esac
  done
}

INSTALL_ROOT="${TEST_AGENT_LOCAL_CLIENT_INSTALL_ROOT:-${HOME}/.local/share/testagent/local-opencode-client}"
CONFIG_DIR="${TEST_AGENT_LOCAL_CLIENT_CONFIG_DIR:-${HOME}/.config/testagent/local-opencode-client}"
STATE_DIR="${TEST_AGENT_LOCAL_CLIENT_STATE_DIR:-${HOME}/.local/state/testagent/local-opencode-client}"
RELEASES_DIR="${INSTALL_ROOT}/releases"
ARTIFACT_CACHE_DIR="${INSTALL_ROOT}/artifact-cache"
umask 077
mkdir -p "${INSTALL_ROOT}" "${CONFIG_DIR}" "${STATE_DIR}"
chmod 0700 "${CONFIG_DIR}" "${STATE_DIR}"
initialize_logging
set_stage prerequisites
require_command curl
require_command openssl
require_command tar
require_command awk
require_command wc
require_command stat
require_command getconf
require_command grep
require_command find
require_command cmp
verify_platform
log_event INFO launcher_prerequisites_verified "stage=${CURRENT_STAGE}"
TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/test-agent-local-client.XXXXXX")"
trap cleanup INT TERM EXIT
PUBLIC_KEY_FILE="${TEMP_DIR}/release-public.pem"
printf '%s' "${PUBLIC_KEY_PEM_BASE64}" | openssl base64 -d -A >"${PUBLIC_KEY_FILE}"

command_name="${1:-setup}"
case "${command_name}" in
  setup|enroll|start|run|--version) ;;
  *) set_stage command_dispatch; fail "不支持的命令: ${command_name}" ;;
esac
log_event INFO launcher_command_started "stage=command_dispatch command=${command_name}"
case "${command_name}" in
  setup)
    [ "$#" -le 1 ] || fail "setup 不接受额外参数"
    # 重复双击安装也是显式升级动作：重新校验签名 catalog 并原子切换到最新 release。
    bootstrap_release
    ensure_runtime
    ensure_enrolled
    install_user_service
    printf '麒麟 ARM64 本地客户端已安装并接入。\n'
    ;;
  enroll)
    [ "$#" -eq 1 ] || fail "enroll 不接受额外参数"
    ensure_runtime
    enroll_client
    rm -f "${STATE_DIR}/re-enrollment-required"
    install_user_service
    printf '本地客户端重新接入成功。\n'
    ;;
  start)
    [ "$#" -eq 1 ] || fail "start 不接受额外参数"
    ensure_runtime
    ensure_enrolled
    install_user_service
    printf '本地客户端已启动并开始重新连接平台。\n'
    ;;
  run)
    [ "$#" -eq 1 ] || fail "run 不接受额外参数"
    run_client
    ;;
  --version)
    [ "$#" -eq 1 ] || fail "--version 不接受额外参数"
    if [ -L "${INSTALL_ROOT}/current" ]; then
      active_version="$(current_version)"
      printf 'test-agent-local-client launcher=%s release=%s\n' "${LAUNCHER_VERSION}" "${active_version}"
    else
      printf 'test-agent-local-client launcher=%s release=not-installed\n' "${LAUNCHER_VERSION}"
    fi
    ;;
esac

log_event INFO launcher_command_completed "stage=${CURRENT_STAGE} command=${command_name}"

cleanup
TEMP_DIR=""
trap - INT TERM EXIT
