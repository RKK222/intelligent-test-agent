# 安装后保存为 /data/testagent/config/memory.env，权限必须为 0600。
# 数据库密码使用 URL-safe 随机字符，禁止空格、换行和 shell 表达式。
TEST_AGENT_MEMORY_SERVICE_IMAGE=test-agent-memory-service:internal
TEST_AGENT_MEMORY_PGVECTOR_IMAGE=test-agent-pgvector:0.8.1-pg16-internal
TEST_AGENT_MEMORY_NGINX_IMAGE=test-agent-memory-nginx:1.27.2-internal

# 独立数据库节点改为具体内网 IP 最稳妥；0.0.0.0 时必须用主机防火墙限制仅 Mem0 节点访问。
TEST_AGENT_MEMORY_DB_BIND_ADDRESS=0.0.0.0
TEST_AGENT_MEMORY_DB_HOST_PORT=5432
TEST_AGENT_MEMORY_DB_NAME=testagent_memory
TEST_AGENT_MEMORY_DB_USER=testagent_memory
TEST_AGENT_MEMORY_DB_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TEST_AGENT_MEMORY_SERVICE_DATABASE_URL=postgresql://testagent_memory:REPLACE_WITH_THE_SAME_DATABASE_PASSWORD@memory-db.internal:5432/testagent_memory

TEST_AGENT_MEMORY_SERVICE_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TEST_AGENT_MEMORY_SERVICE_MODEL_GATEWAY_URL=http://java-vip.internal:8080/api/internal/platform/model-gateway/v1
TEST_AGENT_MEMORY_SERVICE_MODEL_GATEWAY_CLIENT_ID=mem0-cluster
TEST_AGENT_MEMORY_SERVICE_MODEL_GATEWAY_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TEST_AGENT_MEMORY_SERVICE_CHAT_MODEL_ID=memory-chat
TEST_AGENT_MEMORY_SERVICE_CPU_EMBEDDING_MODEL_ID=memory-bge-small-zh-v1.5

# 企业 embedding 不存在时，以下三项必须全部留空；存在时必须全部填写。
TEST_AGENT_MEMORY_SERVICE_ENTERPRISE_EMBEDDING_MODEL_ID=
TEST_AGENT_MEMORY_SERVICE_ENTERPRISE_EMBEDDING_DIMENSION=
TEST_AGENT_MEMORY_SERVICE_ENTERPRISE_EMBEDDING_FINGERPRINT=

TEST_AGENT_MEMORY_SERVICE_POSTGRES_POOL_MIN_SIZE=2
TEST_AGENT_MEMORY_SERVICE_POSTGRES_POOL_MAX_SIZE=30
TEST_AGENT_MEMORY_SERVICE_PROJECTION_BATCH_SIZE=32
TEST_AGENT_MEMORY_SERVICE_PROJECTION_POLL_SECONDS=1
TEST_AGENT_MEMORY_SERVICE_SEARCH_PROFILE_TIMEOUT_SECONDS=1.5

# 每台 Mem0 节点使用不同 NODE_ID，但读取完全相同的数据库、模型和密钥配置。
TEST_AGENT_MEMORY_NODE_ID=node-1
TEST_AGENT_MEMORY_BIND_ADDRESS=0.0.0.0
TEST_AGENT_MEMORY_HOST_PORT=18888

# 仅 VIP 节点使用，逗号分隔，禁止域名中夹带路径。
TEST_AGENT_MEMORY_VIP_BIND_ADDRESS=0.0.0.0
TEST_AGENT_MEMORY_VIP_HOST_PORT=18888
TEST_AGENT_MEMORY_UPSTREAMS=memory-node-1.internal:18888,memory-node-2.internal:18888,memory-node-3.internal:18888
