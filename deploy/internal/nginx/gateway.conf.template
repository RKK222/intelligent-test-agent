map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream test_agent_backend {
    least_conn;
    ${TEST_AGENT_BACKEND_SERVERS}
    keepalive 32;
}

${TEST_AGENT_WORKFLOW_UPSTREAM_BLOCK}

${TEST_AGENT_SERVER_UPSTREAMS}

# 只使用部署脚本生成的静态 upstream 名称；缺失或未知客户端提示继续走默认负载均衡。
map $http_x_test_agent_linux_server_id $test_agent_backend_route {
    default test_agent_backend;
    ${TEST_AGENT_SERVER_ROUTE_MAP}
}

upstream test_agent_xxl_job_admin {
    least_conn;
    ${TEST_AGENT_XXL_JOB_ADMIN_SERVERS}
    keepalive 16;
}

upstream test_agent_toolbox_it_tools {
    ${TEST_AGENT_TOOLBOX_IT_TOOLS_SERVERS}
    keepalive 8;
}

upstream test_agent_toolbox_omni_tools {
    ${TEST_AGENT_TOOLBOX_OMNI_TOOLS_SERVERS}
    keepalive 8;
}

server {
    ${TEST_AGENT_NGINX_LISTEN_DIRECTIVE}
    ${TEST_AGENT_NGINX_ADDITIONAL_LISTEN_DIRECTIVES}
    ${TEST_AGENT_NGINX_TLS_DIRECTIVES}
    server_name _;
    root ${TEST_AGENT_FRONTEND_ROOT};
    index index.html;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # 本地客户端制品由内网 HTTP 直接下载；client key 不参与下载认证。
    location = /downloads/local-opencode-client {
        return 308 /downloads/local-opencode-client/;
    }

    location = /downloads/local-opencode-client/install.sh {
        alias /data/testagent/dist/local-opencode-client/install.sh;
        default_type text/x-shellscript;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/local-opencode-client/stable/manifest.json {
        alias /data/testagent/dist/local-opencode-client/stable/manifest.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/local-opencode-client/stable/manifest.json.sig {
        alias /data/testagent/dist/local-opencode-client/stable/manifest.json.sig;
        default_type application/octet-stream;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location ^~ /downloads/local-opencode-client/releases/ {
        alias /data/testagent/dist/local-opencode-client/releases/;
        autoindex off;
        disable_symlinks on;
        if ($uri ~ "(^|/)\\.") { return 404; }
        default_type application/octet-stream;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location ^~ /downloads/local-opencode-client/ {
        alias /data/testagent/dist/local-opencode-client/;
        autoindex off;
        disable_symlinks on;
        if ($uri ~ "(^|/)\\.") { return 404; }
        default_type application/octet-stream;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /api {
        proxy_pass http://$test_agent_backend_route;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 路由提示在 Nginx 消费后即删除，内部防循环头也不接受外部客户端注入。
        proxy_set_header X-Test-Agent-Linux-Server-Id "";
        proxy_set_header X-Test-Agent-Backend-Routed "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_next_upstream error timeout;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
    }

    # UI Tool 配置不使用应用层凭据，只允许 OpenCode worker 直连同节点 Java；公共入口精确拒绝。
    location = /api/internal/agent/opencode/ui-test-tool/config {
        return 404;
    }

    # 独立工作流HTTP与原生AG-UI SSE同源直达Python，禁止经过Java backend upstream。
    ${TEST_AGENT_WORKFLOW_LOCATION}

    # 服务器终端 ticket 保存在目标 Java 内存，复用同一 linuxServerId 静态路由表定向代理 WebSocket。
    ${TEST_AGENT_TERMINAL_LOCATIONS}

    location = /xxl-job-admin {
        return 308 /xxl-job-admin/;
    }

    # XXL Admin 与平台 API 同源，但使用每个 Java 进程独立的 Servlet 子端口。
    location /xxl-job-admin/ {
        proxy_pass http://test_agent_xxl_job_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        proxy_cache off;
    }

    location /api/ {
        proxy_pass http://$test_agent_backend_route;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 与精确 /api location 保持同一信任边界。
        proxy_set_header X-Test-Agent-Linux-Server-Id "";
        proxy_set_header X-Test-Agent-Backend-Routed "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_next_upstream error timeout;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
    }

    # 工具根路径不暴露上游门户；具体工具深链在 SPA catch-all 之前代理到后台共置工具容器。
    location = /toolbox/apps/it-tools {
        return 308 /toolbox;
    }

    location ^~ /toolbox/apps/it-tools/ {
        proxy_pass http://test_agent_toolbox_it_tools/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /toolbox/apps/omni-tools {
        return 308 /toolbox;
    }

    location ^~ /toolbox/apps/omni-tools/ {
        proxy_pass http://test_agent_toolbox_omni_tools/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# 制品下载固定使用独立明文 HTTP 监听；该 server 不暴露 API、SPA 或目录索引。
server {
    listen ${TEST_AGENT_LOCAL_CLIENT_DOWNLOAD_PORT};
    server_name _;

    location = /downloads/local-opencode-client {
        return 308 /downloads/local-opencode-client/;
    }

    location = /downloads/local-opencode-client/install.sh {
        alias /data/testagent/dist/local-opencode-client/install.sh;
        default_type text/x-shellscript;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/local-opencode-client/stable/manifest.json {
        alias /data/testagent/dist/local-opencode-client/stable/manifest.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/local-opencode-client/stable/manifest.json.sig {
        alias /data/testagent/dist/local-opencode-client/stable/manifest.json.sig;
        default_type application/octet-stream;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location ^~ /downloads/local-opencode-client/releases/ {
        alias /data/testagent/dist/local-opencode-client/releases/;
        autoindex off;
        disable_symlinks on;
        if ($uri ~ "(^|/)\\.") { return 404; }
        default_type application/octet-stream;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location ^~ /downloads/local-opencode-client/ {
        alias /data/testagent/dist/local-opencode-client/;
        autoindex off;
        disable_symlinks on;
        if ($uri ~ "(^|/)\\.") { return 404; }
        default_type application/octet-stream;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        return 404;
    }
}
