# Copy to /data/testagent/config/nginx.env on the frontend Nginx server.
# The current enterprise Nginx is installed under /data/apps/nginx rather than the system path.

# single requires exactly one backend; multi requires at least two comma-separated backends.
TEST_AGENT_NGINX_MODE=single
TEST_AGENT_NGINX_BACKENDS=122.233.30.114:8080
# 当前 release 不启用 Python workflow；留空会生成显式 503，后续启用时再填写独立服务地址。
TEST_AGENT_NGINX_WORKFLOW_UPSTREAM=
# linuxServerId=Java监听地址；多节点时逐台填写，同时用于普通 HTTP 首跳路由和服务器终端 WebSocket。
TEST_AGENT_NGINX_SERVER_ROUTES=test-agent-backend-122-233-30-114=122.233.30.114:8080
# 每个 Java 进程的 XXL Admin 独立端口；multi 模式按逗号列出所有节点。
TEST_AGENT_NGINX_XXL_JOB_ADMINS=122.233.30.114:18080
# 工具容器与后台共置；逗号分隔，首项主用、其余仅在连接失败时备用。
TEST_AGENT_NGINX_TOOLBOX_IT_TOOLS_UPSTREAM=122.233.30.4:18120,122.233.30.114:18120
TEST_AGENT_NGINX_TOOLBOX_OMNI_TOOLS_UPSTREAM=122.233.30.4:18121,122.233.30.114:18121

TEST_AGENT_NGINX_LISTEN_PORT=443
# 独立明文 HTTP 下载监听，只暴露 /downloads/local-opencode-client/，不得与网关端口重复。
TEST_AGENT_LOCAL_CLIENT_DOWNLOAD_PORT=80
# 可选，逗号分隔；用于同一 server 块额外监听实体 IP 直连端口，例如保留 80 并增加 9996。
TEST_AGENT_NGINX_ADDITIONAL_LISTEN_PORTS=
TEST_AGENT_NGINX_TLS_ENABLED=true
TEST_AGENT_NGINX_TLS_CERTIFICATE=/data/testagent/config/tls/test-agent.crt
TEST_AGENT_NGINX_TLS_CERTIFICATE_KEY=/data/testagent/config/tls/test-agent.key
TEST_AGENT_FRONTEND_ROOT=/data/testagent/frontend

# Must point to a .conf file included by the active Nginx main configuration.
# configure-single-deployment.sh frontend detects the actual included directory and rewrites this value.
TEST_AGENT_NGINX_CONF_PATH=/data/apps/nginx/conf/conf.d/test-agent-gateway.conf
TEST_AGENT_NGINX_BIN=/data/apps/nginx/sbin/nginx
TEST_AGENT_NGINX_PREFIX=/data/apps/nginx
TEST_AGENT_NGINX_MAIN_CONF=/data/apps/nginx/conf/nginx.conf
TEST_AGENT_NGINX_RELOAD_MODE=binary
