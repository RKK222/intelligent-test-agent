# Append these values to /data/testagent/config/backend.env on every Java platform node.
# Never commit populated secrets. The first and second HMAC values must respectively
# match TEST_AGENT_WORKFLOW_PLATFORM_HMAC_SECRET and
# TEST_AGENT_RUNNER_PLATFORM_HMAC_SECRET in workflow.env.

TEST_AGENT_WORKFLOW_CAPABILITY_HMAC_SECRET=REPLACE_SAME_VALUE_AS_WORKFLOW_PLATFORM_HMAC_SECRET
TEST_AGENT_WORKFLOW_RUNNER_PLATFORM_HMAC_SECRET=REPLACE_SAME_VALUE_AS_RUNNER_PLATFORM_HMAC_SECRET
TEST_AGENT_WORKFLOW_RUNNER_ID=runner-analysis-1
TEST_AGENT_WORKFLOW_RUNNER_PUBLIC_KEY_PATH=/data/testagent/config/workflow-runner-public.pem
TEST_AGENT_WORKFLOW_MODEL_GATEWAY_URL=http://10.20.30.40:8080/api/internal/platform/model-gateway/v1
TEST_AGENT_WORKFLOW_HMAC_CLOCK_SKEW=30s
TEST_AGENT_WORKFLOW_NONCE_TTL=60s
TEST_AGENT_WORKFLOW_CHECKOUT_TICKET_TTL=2m
TEST_AGENT_WORKFLOW_MODEL_GRANT_TTL=5m
