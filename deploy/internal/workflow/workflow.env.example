# Copy to /data/testagent/config/workflow.env. Never commit the populated file.

# Image tags and IDs are read from the signed release.env beside the deployment scripts.

# Python/Runner service identities. Generate three distinct random values with at least 32 bytes.
# The first and third values must respectively match the Java-side values documented in backend.env.example.
TEST_AGENT_WORKFLOW_PLATFORM_HMAC_SECRET=REPLACE_SAME_VALUE_AS_BACKEND_WORKFLOW_CAPABILITY_HMAC_SECRET
TEST_AGENT_WORKFLOW_RUNNER_HMAC_SECRET=REPLACE_WORKER_TO_RUNNER_32_BYTE_MINIMUM_SECRET
TEST_AGENT_WORKFLOW_RUNNER_ID=runner-analysis-1

# Workflow PostgreSQL is a separate database and minimum-privilege role in the existing cluster.
TEST_AGENT_WORKFLOW_DATABASE_URL=postgresql+asyncpg://test_agent_workflow:REPLACE_PASSWORD@10.20.30.20:5432/test_agent_workflow
# Only the one-shot initialize command receives this owner URL; long-running containers use the runtime URL above.
TEST_AGENT_WORKFLOW_MIGRATION_DATABASE_URL=postgresql+asyncpg://test_agent_workflow_owner:REPLACE_OWNER_PASSWORD@10.20.30.20:5432/test_agent_workflow

# Redis ACL user can only PING and exact GET/PTTL under test-agent:token:*.
TEST_AGENT_WORKFLOW_REDIS_URL=redis://workflow-auth:REPLACE_PASSWORD@10.20.30.30:6379/0

# Java capability API is reachable by workflow-service/worker only. The raw Bearer token is never sent here.
TEST_AGENT_WORKFLOW_PLATFORM_BASE_URL=http://10.20.30.40:8080

# Runner management API is reachable by workflow Worker only and never by analysis-task containers.
TEST_AGENT_WORKFLOW_RUNNER_BASE_URL=http://10.20.30.50:8091
TEST_AGENT_WORKFLOW_RUNNER_PUBLIC_KEY_PATH=/run/secrets/workflow-runner-public.pem
TEST_AGENT_WORKFLOW_RUNNER_PUBLIC_KEY_HOST_PATH=/data/testagent/config/workflow-runner-public.pem
TEST_AGENT_WORKFLOW_WORKER_ID=workflow-worker-1

# 这些公开模型ID必须存在于平台模型网关目录；代码智能体会被固定到analysis模型。
TEST_AGENT_WORKFLOW_INTENT_MODEL_NAME=workflow-intent
TEST_AGENT_WORKFLOW_SYNTHESIS_MODEL_NAME=workflow-impact-synthesis
TEST_AGENT_WORKFLOW_REPORT_QA_MODEL_NAME=workflow-report-qa
TEST_AGENT_WORKFLOW_ANALYSIS_MODEL_NAME=workflow-code-analysis

# Workflow API/Worker 访问模型网关的服务端路由。未配置时沿用grant返回地址；当Runner与
# Workflow位于不同网络视角时可单独配置，但grant中的原地址仍原样下发给Runner。
TEST_AGENT_WORKFLOW_SERVER_MODEL_GATEWAY_URL=http://10.20.30.40:8080/api/internal/platform/model-gateway/v1

# The Runner model gateway must use the exact IPv4/port allowed by DOCKER-USER.
TEST_AGENT_MODEL_GATEWAY_CIDR=10.20.30.40/32
TEST_AGENT_MODEL_GATEWAY_PORT=8080

# Analysis bridge and host paths. The source root is never mounted into workflow-service or Worker.
TEST_AGENT_ANALYSIS_NETWORK=test-agent-analysis-egress
TEST_AGENT_ANALYSIS_SUBNET=172.31.250.0/24
TEST_AGENT_WORKFLOW_RUNNER_ROOT=/data/testagent/workflow-runner
TEST_AGENT_WORKFLOW_RUNNER_CREDENTIAL_ROOT=/run/test-agent-workflow-credentials
TEST_AGENT_WORKFLOW_RUNNER_PRIVATE_KEY_PATH=/run/secrets/workflow-runner-private.pem
TEST_AGENT_WORKFLOW_GIT_KNOWN_HOSTS_HOST_PATH=/data/testagent/config/workflow-git-known-hosts
TEST_AGENT_WORKFLOW_RUNNER_MINIMUM_FREE_BYTES=10737418240

# Runner pydantic environment (same locked values, explicit to keep each container independently auditable).
TEST_AGENT_RUNNER_RUNNER_ID=runner-analysis-1
TEST_AGENT_RUNNER_WORKER_HMAC_SECRET=REPLACE_SAME_VALUE_AS_TEST_AGENT_WORKFLOW_RUNNER_HMAC_SECRET
TEST_AGENT_RUNNER_PLATFORM_HMAC_SECRET=REPLACE_SAME_VALUE_AS_BACKEND_WORKFLOW_RUNNER_PLATFORM_HMAC_SECRET
TEST_AGENT_RUNNER_PLATFORM_BASE_URL=http://10.20.30.40:8080
TEST_AGENT_RUNNER_ROOT=/data/testagent/workflow-runner
TEST_AGENT_RUNNER_CREDENTIAL_ROOT=/run/test-agent-workflow-credentials
TEST_AGENT_RUNNER_PRIVATE_KEY_PATH=/run/secrets/workflow-runner-private.pem
TEST_AGENT_RUNNER_KNOWN_HOSTS_PATH=/run/secrets/workflow-git-known-hosts
TEST_AGENT_WORKFLOW_RUNNER_PRIVATE_KEY_HOST_PATH=/data/testagent/config/workflow-runner-private.pem
TEST_AGENT_RUNNER_ANALYSIS_IMAGE=test-agent-analysis-task@sha256:REPLACE_64_HEX_DIGEST
TEST_AGENT_RUNNER_ANALYSIS_NETWORK=test-agent-analysis-egress
TEST_AGENT_RUNNER_ANALYSIS_NETWORK_SUBNET=172.31.250.0/24
TEST_AGENT_RUNNER_MODEL_GATEWAY_URL=http://10.20.30.40:8080/api/internal/platform/model-gateway/v1
TEST_AGENT_RUNNER_MODEL_GATEWAY_CIDR=10.20.30.40/32
TEST_AGENT_RUNNER_MODEL_GATEWAY_PORT=8080
TEST_AGENT_RUNNER_MINIMUM_FREE_BYTES=10737418240

# API and worker runtime.
TEST_AGENT_WORKFLOW_API_PORT=8090
TEST_AGENT_WORKFLOW_RUNNER_PORT=8091
TEST_AGENT_WORKFLOW_API_BIND_ADDRESS=127.0.0.1
TEST_AGENT_WORKFLOW_RUNNER_BIND_ADDRESS=127.0.0.1
TEST_AGENT_WORKFLOW_CONTROL_NETWORK=test-agent-workflow-control
TEST_AGENT_WORKFLOW_NODE_ROLE=all
TEST_AGENT_WORKFLOW_WORKSPACE_RETENTION_HOURS=48
TEST_AGENT_WORKFLOW_WORKER_LEASE_SECONDS=60
