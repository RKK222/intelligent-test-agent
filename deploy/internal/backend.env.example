# Copy this file to /data/testagent/config/backend.env on the backend server.
# Keep environment-specific secrets only on the target server. The platform RSA key is embedded in the JAR.
# 2026-07-27 site profile: external XXL-JOB MySQL is 122.210.106.43:3306/xxl_job
# with root account. The rotated production password is delivered only through
# the sensitive .4/.114 node packages and must not be committed to this template.

# The default below is the single-backend 122.233.30.114 example. For multi-backend
# deployment, copy this file per node and give every physical server a unique stable
# advertised host and linux server ID. See deploy/internal/MULTI-BACKEND.md.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
TEST_AGENT_DEPLOYMENT_MODE=internal
TEST_AGENT_SERVER_ADVERTISED_HOST=122.233.30.114
TEST_AGENT_LINUX_SERVER_ID=test-agent-backend-122-233-30-114

# 必填：所有 TCDS 固定业务路径均相对此 HTTP/HTTPS 绝对地址解析。
TEST_AGENT_TCDS_BASE_URL=http://tcds.example.internal

# Current enterprise PostgreSQL endpoint. Only the password remains environment-specific.
TEST_AGENT_DB_URL=jdbc:postgresql://122.233.30.147:5432/postgres
TEST_AGENT_DB_USERNAME=postgres
TEST_AGENT_DB_PASSWORD=REPLACE_PRODUCTION_DB_PASSWORD
# 可选：选择已打入后端 jar 的 JDBC 驱动类；当前交付包默认包含 PostgreSQL 驱动。
TEST_AGENT_DB_DRIVER_CLASS_NAME=org.postgresql.Driver

# 运营事实仅写独立 ClickHouse 节点；生产开启后不再从 PostgreSQL 旧汇总表查询。
TEST_AGENT_ANALYTICS_CLICKHOUSE_ENABLED=true
TEST_AGENT_ANALYTICS_CLICKHOUSE_URL=jdbc:clickhouse://REPLACE_CLICKHOUSE_HOST:8123/testagent_analytics
TEST_AGENT_ANALYTICS_CLICKHOUSE_USERNAME=testagent_analytics
TEST_AGENT_ANALYTICS_CLICKHOUSE_PASSWORD=REPLACE_CLICKHOUSE_PASSWORD
# 首次切换时临时设置；验证成功后把 BACKFILL_ENABLED 改回 false。
TEST_AGENT_ANALYTICS_CLICKHOUSE_BACKFILL_ENABLED=false
TEST_AGENT_ANALYTICS_CLICKHOUSE_BACKFILL_START=2025-01-01T00:00:00Z
TEST_AGENT_ANALYTICS_CLICKHOUSE_BACKFILL_END=
TEST_AGENT_ANALYTICS_CLICKHOUSE_CLEANUP_LEGACY_ROLLUPS=false

# Redis server.
TEST_AGENT_REDIS_HOST=122.233.30.20
TEST_AGENT_REDIS_PORT=6379
TEST_AGENT_REDIS_PASSWORD=

# XXL-JOB Admin 使用外部共享 MySQL，与平台 PostgreSQL 完全分离。
# 每台 Linux 只运行一个 Java；本机 Admin/executor 固定配对，所有节点共享 MySQL 和 access token。
# 纳管密码包含 shell 特殊字符，写入 backend.env 时按 dotenv 原值保存，不要通过命令行参数传递。
TEST_AGENT_XXL_JOB_ENABLED=true
TEST_AGENT_XXL_JOB_MYSQL_URL=jdbc:mysql://122.210.106.43:3306/xxl_job?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
TEST_AGENT_XXL_JOB_MYSQL_USERNAME=root
TEST_AGENT_XXL_JOB_MYSQL_PASSWORD=REPLACE_XXL_JOB_MYSQL_PASSWORD
TEST_AGENT_XXL_JOB_ACCESS_TOKEN=REPLACE_XXL_JOB_ACCESS_TOKEN
TEST_AGENT_XXL_JOB_ADMIN_PORT=18080
TEST_AGENT_XXL_JOB_EXECUTOR_PORT=9999
# 当前企业入口固定为 HTTP；若入口升级为 HTTPS，必须改回 true。
TEST_AGENT_XXL_JOB_COOKIE_SECURE=false

# Browser entry is the frontend Nginx server. Keep this in sync with /data/testagent/config/docker.env.
TEST_AGENT_CORS_ALLOWED_ORIGINS=https://122.233.30.2
TEST_AGENT_API_TOKEN=

# 本地客户端 key/grant 仅允许 HTTPS/WSS。后台只信任这些 Nginx 源 IP 写入的 X-Forwarded-Proto。
TEST_AGENT_LOCAL_CLIENT_ALLOW_INSECURE_CONTROL=false
TEST_AGENT_LOCAL_CLIENT_TRUSTED_PROXY_ADDRESSES=122.233.30.2

# Must match /data/testagent/config/docker.env on the Docker worker host.
TEST_AGENT_OPENCODE_MANAGER_TOKEN=REPLACE_MANAGER_TOKEN

# Shared data root mounted by opencode-worker. Java writes .serverid/.serverhost here,
# and the worker manager reads the same files before connecting back to this Java server.
SYS_DATA_ROOT_DIR=/data/testagent/data

# Cross-instance server broadcast. Keep enabled for enterprise deployment.
TEST_AGENT_SERVER_BROADCAST_ENABLED=true
TEST_AGENT_SERVER_BROADCAST_CHANNEL=test-agent:server-broadcast

# Enterprise model provider.
# Provider base URLs and the upstream token are maintained by SUPER_ADMIN in
# System Management -> Internal Model Providers. Do not put the upstream token here.
TEST_AGENT_MODEL_CATALOG_SOURCE=internal
TEST_AGENT_INTERNAL_PROXY_API_KEY=REPLACE_INTERNAL_PROXY_API_KEY

# LobeHub 服务身份只用于 ticket redeem/revoke HMAC。必须与 lobehub.env 一致且至少 32 bytes。
TEST_AGENT_LOBEHUB_HMAC_SECRET=REPLACE_SAME_32_BYTE_MINIMUM_HMAC_SECRET_AS_LOBEHUB
TEST_AGENT_LOBEHUB_CLIENT_ID=lobehub
TEST_AGENT_LOBEHUB_TICKET_TTL=60s
TEST_AGENT_LOBEHUB_GRANT_TTL=30d
TEST_AGENT_LOBEHUB_HMAC_CLOCK_SKEW=60s
TEST_AGENT_LOBEHUB_NONCE_TTL=120s
TEST_AGENT_MODEL_GATEWAY_MULTIPART_DIRECTORY=/data/testagent/tmp/model-gateway
TEST_AGENT_MODEL_GATEWAY_MAX_MULTIPART_PART_BYTES=100MB

# Runtime capacity and scheduler defaults.
TEST_AGENT_DB_POOL_INITIAL_SIZE=1
TEST_AGENT_DB_POOL_MIN_IDLE=1
TEST_AGENT_DB_POOL_MAX_ACTIVE=10
TEST_AGENT_DB_POOL_MAX_WAIT_MILLIS=30000
TEST_AGENT_DB_POOL_TEST_ON_BORROW=true

# Redis/runtime safe defaults. Keep them explicit so the target file is independently auditable.
TEST_AGENT_REDIS_TIMEOUT=1s
TEST_AGENT_RATE_LIMIT_ENABLED=false
TEST_AGENT_RATE_LIMIT_CAPACITY=120
TEST_AGENT_RATE_LIMIT_WINDOW=1m
TEST_AGENT_REDIS_SUMMARY_ENABLED=false
TEST_AGENT_REDIS_SUMMARY_ROLLOUT_PERCENTAGE=0
TEST_AGENT_LEGACY_RUN_WITHOUT_CONTEXT_ENABLED=true
# 5 MiB 以上改走渐进只读预览；这不是完整预览或上传总大小上限。
TEST_AGENT_MAX_PREVIEW_BYTES=5242880
TEST_AGENT_UPLOAD_CHUNK_BYTES=262144
TEST_AGENT_MAX_DIRECTORY_ENTRIES=1000

# Java/manager routing boundaries.
TEST_AGENT_BACKEND_HEARTBEAT_INTERVAL=5s
TEST_AGENT_BACKEND_STALE_AFTER=10s
TEST_AGENT_OPENCODE_MANAGER_COMMAND_TIMEOUT=10s
TEST_AGENT_BACKEND_DISCOVERY_LIMIT=100

# 企业交付默认启用服务器终端；shell 继承 Java systemd 的运行用户，不切换用户或提权，正式入口只能是 WSS。
TEST_AGENT_SERVER_TERMINAL_ENABLED=true
TEST_AGENT_SERVER_TERMINAL_WORKING_DIRECTORY=/data/testagent
TEST_AGENT_SERVER_TERMINAL_PUBLIC_WEBSOCKET_BASE_URL=wss://122.233.30.2
TEST_AGENT_SERVER_TERMINAL_ALLOW_INSECURE_WEBSOCKET=false

# 全部周期任务（含夜间 15 分钟分发与 5 分钟补偿）由 XXL-JOB 执行；应用内无 scheduler runner。
