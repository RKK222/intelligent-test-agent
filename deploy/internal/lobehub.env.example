# Copy to /data/testagent/config/lobehub.env and chmod 0600.
# This template contains placeholders only. Never commit the populated file.

# Immutable tags must match release.env. Installer additionally checks each loaded image ID and tar checksum.
LOBEHUB_APP_IMAGE=test-agent/lobehub:v2.2.11-platform.1
LOBEHUB_PARADEDB_IMAGE=test-agent/paradedb:pg17-v2.2.11-platform.1
LOBEHUB_RUSTFS_IMAGE=test-agent/rustfs:v2.2.11-platform.1

# Independent LobeHub database and account. The platform Flyway process must not use this database.
POSTGRES_DB=lobehub
POSTGRES_USER=lobehub
POSTGRES_PASSWORD=REPLACE_LOBEHUB_DATABASE_PASSWORD
DATABASE_URL=postgresql://lobehub:REPLACE_URL_ENCODED_DATABASE_PASSWORD@test-agent-lobehub-db:5432/lobehub
DATABASE_DRIVER=node

# Shared Redis DB 0 with a dedicated app prefix. ACL must also restrict channels and commands.
LOBEHUB_REDIS_HOST=REPLACE_SHARED_REDIS_HOST
LOBEHUB_REDIS_PORT=6379
LOBEHUB_REDIS_USERNAME=lobehub
LOBEHUB_REDIS_PASSWORD=REPLACE_SHARED_REDIS_PASSWORD
REDIS_URL=redis://lobehub:REPLACE_URL_ENCODED_REDIS_PASSWORD@REPLACE_SHARED_REDIS_HOST:6379/0
REDIS_PREFIX=lobehub:app:

# Private RustFS bucket. MC_HOST_lobehub lets the offline init task avoid secrets in argv.
RUSTFS_ACCESS_KEY=REPLACE_RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=REPLACE_RUSTFS_SECRET_KEY
LOBEHUB_S3_BUCKET=lobehub-private
S3_ENDPOINT=http://test-agent-lobehub-rustfs:9000
S3_BUCKET=lobehub-private
S3_ACCESS_KEY_ID=REPLACE_RUSTFS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_RUSTFS_SECRET_KEY
S3_ENABLE_PATH_STYLE=1
S3_SET_ACL=0
MC_HOST_lobehub=http://REPLACE_URL_ENCODED_ACCESS_KEY:REPLACE_URL_ENCODED_SECRET_KEY@test-agent-lobehub-rustfs:9000

# Platform handoff and server-side encrypted model delegation.
APP_URL=http://chat.internal
INTERNAL_APP_URL=http://test-agent-lobehub-app:3210
# Keep 127.0.0.1 when Nginx is on this host. For a separate proxy, use this host's approved internal IPv4 and firewall it to the proxy.
LOBEHUB_APP_BIND_ADDRESS=127.0.0.1
AUTH_SECRET=REPLACE_LOBEHUB_SESSION_SECRET_AT_LEAST_32_BYTES
# Both encryption keys must be generated with: openssl rand -base64 32
KEY_VAULTS_SECRET=REPLACE_BASE64_32_BYTE_KEY_VAULT_SECRET
# Generate independently with: openssl rand -hex 32
ENTERPRISE_INTERNAL_SCHEDULER_SECRET=REPLACE_INTERNAL_SCHEDULER_SECRET_AT_LEAST_32_BYTES
PLATFORM_MODEL_GRANT_ENCRYPTION_KEY=REPLACE_BASE64_32_BYTE_MODEL_GRANT_KEY
PLATFORM_SSO_HMAC_SECRET=REPLACE_SAME_32_BYTE_MINIMUM_HMAC_SECRET_AS_BACKEND
PLATFORM_SSO_ENABLED=1
PLATFORM_LAUNCH_URL=http://test-agent.internal/lobehub/launch
PLATFORM_SSO_REDEEM_URL=http://test-agent.internal/api/internal/platform/lobehub-sso/tickets/redeem
PLATFORM_SSO_REVOKE_URL=http://test-agent.internal/api/internal/platform/lobehub-sso/grants/revoke
PLATFORM_MODEL_GATEWAY_BASE_URL=http://test-agent.internal/api/internal/platform/model-gateway/v1

# One switch activates all fork-enforced offline/provider/auth policies. UI hiding is not enforcement.
LOBEHUB_ENTERPRISE_OFFLINE=1
# Offline scheduled tasks run inline with their creator identity; queue would re-enable QStash.
AGENT_RUNTIME_MODE=local
TELEMETRY_DISABLED=1
# v2.2.11-platform.1 fails closed: local/device execution remains disabled on every client.
LOBEHUB_DEVICE_EXECUTION_MODE=disabled
