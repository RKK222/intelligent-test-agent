# Copy to /data/testagent/config/lobehub.env and chmod 0600.
# This template contains placeholders only. Never commit the populated file.

# Digest-pinned image references must match release.env in the offline artifact set.
LOBEHUB_APP_IMAGE=registry.internal/test-agent/lobehub@sha256:REPLACE_64_HEX_DIGEST
LOBEHUB_PARADEDB_IMAGE=registry.internal/test-agent/paradedb@sha256:REPLACE_64_HEX_DIGEST
LOBEHUB_RUSTFS_IMAGE=registry.internal/test-agent/rustfs@sha256:REPLACE_64_HEX_DIGEST

# Independent LobeHub database and account. The platform Flyway process must not use this database.
POSTGRES_DB=lobehub
POSTGRES_USER=lobehub
POSTGRES_PASSWORD=REPLACE_LOBEHUB_DATABASE_PASSWORD
DATABASE_URL=postgresql://lobehub:REPLACE_URL_ENCODED_DATABASE_PASSWORD@test-agent-lobehub-db:5432/lobehub

# Shared Redis DB 0 with a dedicated app prefix. ACL must also restrict channels and commands.
LOBEHUB_REDIS_HOST=REPLACE_SHARED_REDIS_HOST
LOBEHUB_REDIS_PORT=6379
LOBEHUB_REDIS_USERNAME=lobehub
LOBEHUB_REDIS_PASSWORD=REPLACE_SHARED_REDIS_PASSWORD
REDIS_URL=redis://lobehub:REPLACE_URL_ENCODED_REDIS_PASSWORD@REPLACE_SHARED_REDIS_HOST:6379/0
REDIS_PREFIX=lobehub:app:

# Private RustFS bucket. MC_HOST_lobehub lets the offline init task avoid secrets in argv.
RUSTFS_ACCESS_KEY=REPLACE_RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=REPLACE_RUSTFS_SECRET_KEY
LOBEHUB_S3_BUCKET=lobehub-private
S3_ENDPOINT=http://test-agent-lobehub-rustfs:9000
S3_BUCKET=lobehub-private
S3_ACCESS_KEY_ID=REPLACE_RUSTFS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_RUSTFS_SECRET_KEY
S3_SET_ACL=0
MC_HOST_lobehub=http://REPLACE_URL_ENCODED_ACCESS_KEY:REPLACE_URL_ENCODED_SECRET_KEY@test-agent-lobehub-rustfs:9000

# Platform handoff and server-side encrypted model delegation.
APP_URL=http://chat.internal
NEXTAUTH_URL=http://chat.internal/api/auth
LOBEHUB_PLATFORM_BASE_URL=http://test-agent.internal
LOBEHUB_PLATFORM_LAUNCH_URL=http://test-agent.internal/lobehub/launch
LOBEHUB_PLATFORM_REDEEM_URL=http://test-agent.internal/api/internal/platform/lobehub-sso/tickets/redeem
LOBEHUB_PLATFORM_REVOKE_URL=http://test-agent.internal/api/internal/platform/lobehub-sso/grants/revoke
LOBEHUB_PLATFORM_HMAC_SECRET=REPLACE_SAME_32_BYTE_MINIMUM_HMAC_SECRET_AS_BACKEND
LOBEHUB_MODEL_GRANT_ENCRYPTION_KEY=REPLACE_32_BYTE_MINIMUM_ENCRYPTION_KEY
KEY_VAULTS_SECRET=REPLACE_LOBEHUB_KEY_VAULT_SECRET
NEXT_AUTH_SECRET=REPLACE_LOBEHUB_SESSION_SECRET
LOBEHUB_SESSION_MAX_AGE_SECONDS=86400
LOBEHUB_COOKIE_SECURE=false
LOBEHUB_COOKIE_SAME_SITE=lax
LOBEHUB_COOKIE_HOST_ONLY=true

# The fork exposes exactly one provider adapter and obtains the per-user opaque grant after ticket redemption.
LOBEHUB_ENTERPRISE_PROVIDER_ONLY=true
LOBEHUB_ENTERPRISE_MODEL_BASE_URL=http://test-agent.internal/api/internal/platform/model-gateway/v1
LOBEHUB_ENTERPRISE_MODEL_GRANT_STORAGE=server-encrypted

# Fork-enforced offline and execution policy. UI hiding is not considered enforcement.
LOBEHUB_OFFLINE_MODE=true
LOBEHUB_DISABLE_PUBLIC_SEARCH=true
LOBEHUB_DISABLE_SAAS_CONNECTORS=true
LOBEHUB_DISABLE_BYOK=true
LOBEHUB_DISABLE_TELEMETRY=true
LOBEHUB_DISABLE_UPDATE_CHECK=true
LOBEHUB_DISABLE_RUNTIME_DOWNLOADS=true
LOBEHUB_DISABLE_LOCAL_REGISTRATION=true
LOBEHUB_DISABLE_PASSWORD_LOGIN=true
LOBEHUB_DISABLE_CUSTOM_IDENTITY_PROVIDERS=true
LOBEHUB_WINDOWS_EXECUTION_ENABLED=false
LOBEHUB_LINUX_EXECUTION_ENABLED=false
# 仅在目标发行版/内核真实沙箱验收通过并把上一项改为 true 时设置。
LOBEHUB_LINUX_SANDBOX_APPROVAL_FILE=REPLACE_ONLY_AFTER_TARGET_SANDBOX_VERIFICATION
