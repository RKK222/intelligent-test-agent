#!/bin/sh
set -eu

# OpenCode主进程需要本地relay token，但仓库命令只获得这组无密钥环境变量。
exec /usr/bin/env -i \
  HOME="${HOME:-/tmp}" \
  XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}" \
  PATH="/usr/local/lib/codex/bin:/usr/local/lib/opencode/bin:/usr/local/bin:/usr/bin:/bin" \
  LANG="${LANG:-C.UTF-8}" \
  LC_ALL="${LC_ALL:-C.UTF-8}" \
  /bin/sh "$@"
