<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enterprise.testagent.persistence.mybatis.ExternalApiCredentialMapper">

    <resultMap id="credentialRow" type="com.enterprise.testagent.persistence.mybatis.ExternalApiCredentialRow">
        <constructor>
            <arg column="credential_id" javaType="java.lang.String"/>
            <arg column="tool_code" javaType="java.lang.String"/>
            <arg column="tool_name" javaType="java.lang.String"/>
            <arg column="encrypted_api_key" javaType="java.lang.String"/>
            <arg column="api_key_fingerprint" javaType="java.lang.String"/>
            <arg column="key_hint" javaType="java.lang.String"/>
            <arg column="enabled" javaType="_boolean"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <resultMap id="scopeRow" type="com.enterprise.testagent.persistence.mybatis.ExternalApiCredentialScopeRow">
        <constructor>
            <arg column="credential_id" javaType="java.lang.String"/>
            <arg column="scope_code" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <sql id="credentialColumns">
        credential_id, tool_code, tool_name, encrypted_api_key, api_key_fingerprint,
        key_hint, enabled, created_at, updated_at
    </sql>

    <sql id="credentialFilter">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (LOWER(tool_code) LIKE '%' || LOWER(#{keyword}) || '%'
                    OR LOWER(tool_name) LIKE '%' || LOWER(#{keyword}) || '%')
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
    </sql>

    <select id="findAllCredentials" resultMap="credentialRow">
        SELECT <include refid="credentialColumns"/>
        FROM external_api_credentials
        ORDER BY tool_code ASC
    </select>

    <select id="findCredentialPage" resultMap="credentialRow">
        SELECT <include refid="credentialColumns"/>
        FROM external_api_credentials
        <include refid="credentialFilter"/>
        ORDER BY created_at DESC, credential_id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countCredentials" resultType="long">
        SELECT COUNT(*) FROM external_api_credentials
        <include refid="credentialFilter"/>
    </select>

    <select id="findCredentialById" resultMap="credentialRow">
        SELECT <include refid="credentialColumns"/>
        FROM external_api_credentials
        WHERE credential_id = #{credentialId}
    </select>

    <select id="findScopesByCredentialIds" resultMap="scopeRow">
        SELECT credential_id, scope_code
        FROM external_api_credential_scopes
        WHERE credential_id IN
        <foreach collection="credentialIds" item="credentialId" open="(" separator="," close=")">
            #{credentialId}
        </foreach>
        ORDER BY credential_id ASC, scope_code ASC
    </select>

    <select id="countByToolCode" resultType="long">
        SELECT COUNT(*) FROM external_api_credentials WHERE tool_code = #{toolCode}
    </select>

    <insert id="insertCredential">
        INSERT INTO external_api_credentials(
            credential_id, tool_code, tool_name, encrypted_api_key, api_key_fingerprint,
            key_hint, enabled, created_at, updated_at
        ) VALUES (
            #{credentialId}, #{toolCode}, #{toolName}, #{encryptedApiKey}, #{apiKeyFingerprint},
            #{keyHint}, #{enabled}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <insert id="insertScope">
        INSERT INTO external_api_credential_scopes(credential_id, scope_code)
        VALUES (#{credentialId}, #{scopeCode})
    </insert>

    <delete id="deleteScopes">
        DELETE FROM external_api_credential_scopes WHERE credential_id = #{credentialId}
    </delete>

    <update id="updateDetails">
        UPDATE external_api_credentials
        SET tool_name = #{toolName}, enabled = #{enabled}, updated_at = #{updatedAt}
        WHERE credential_id = #{credentialId}
    </update>

    <update id="updateKey">
        UPDATE external_api_credentials
        SET encrypted_api_key = #{encryptedApiKey},
            api_key_fingerprint = #{apiKeyFingerprint},
            key_hint = #{keyHint},
            updated_at = #{updatedAt}
        WHERE credential_id = #{credentialId}
    </update>

    <delete id="deleteCredential">
        DELETE FROM external_api_credentials WHERE credential_id = #{credentialId}
    </delete>
</mapper>
